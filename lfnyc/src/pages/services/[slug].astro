---
import Site from '../../layouts/Site.astro';
import ContactBand from '../../components/ContactBand.astro';
import { services, brand } from '../../data/site';
export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}
const { service } = Astro.props;
---

<Site
  title={service.name}
  description={service.description}
  service={service.name}
>
  <div class="service-hero shell">
    <div class="page-head">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span>{service.name}</span>
      </nav>
      <p class="label">{service.eyebrow}</p>
      <h1>{service.title}</h1>
      <p class="lede">{service.lead}</p>
      <a class="button" href={`/contact/?service=${service.slug}`}>
        {service.cta} <span aria-hidden="true">↗</span>
      </a>
      {service.slug === 'tech-support' && (
        <p class="reading">
          <a class="text-link" href={`tel:${brand.tel}`}>
            Call {brand.phone} <span aria-hidden="true">↗</span>
          </a>
        </p>
      )}
    </div>
    <figure>
      <img
        src={`/images/${service.image}`}
        srcset={`/images/${service.image.replace('.webp', '-480.webp')} 480w, /images/${service.image.replace('.webp', '-800.webp')} 800w, /images/${service.image} 900w`}
        sizes="(max-width:850px) 90vw, 44vw"
        alt={service.alt}
        width="900"
        height="900"
        fetchpriority="high"
      />
    </figure>
  </div>
  <section
    class="content-split section shell"
    aria-labelledby="service-details"
  >
    <div>
      <p class="label">The useful part</p>
      <h2 id="service-details">
        WHAT WE
        <br />
        HELP YOU DO.
      </h2>
      <p class="reading">{service.description}</p>
    </div>
    <ul class="feature-list">
      {service.items.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </section>
  <section class="section shell" aria-labelledby="service-process">
    <p class="label">A clear way forward</p>
    <h2 id="service-process">
      FROM THE FIRST
      <br />
      CONVERSATION.
    </h2>
    <div class="process">
      {service.process.map((step, index) => (
        <article>
          <p class="label">0{index + 1}</p>
          <p>{step}</p>
        </article>
      ))}
    </div>
  </section>
  {service.slug === 'websites' && (
    <section class="content-split section shell">
      <div>
        <p class="label">Timing, in writing</p>
        <h2>
          A REAL SCOPE.
          <br />A CLEAR CLOCK.
        </h2>
      </div>
      <div>
        <p class="reading">
          A qualifying website scope may include our written 14-day promise. We
          agree eligibility, the starting point, the content and access each
          side supplies, and the remedy if our qualifying work is late.
        </p>
        <p class="reading">
          The first conversation is free. Your written scope sets the price
          before work starts.
        </p>
        <a class="text-link" href="/work/">
          See published website work <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  )}
  <ContactBand
    heading={
      service.slug === 'tech-support'
        ? 'Tell us what stopped working.'
        : service.slug === 'business-systems'
          ? 'Show us the repeated work.'
          : 'Let’s make the next step easier.'
    }
  />
</Site>
