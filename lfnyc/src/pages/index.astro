---
import Site from '../layouts/Site.astro';
import ContactBand from '../components/ContactBand.astro';
import WorkCard from '../components/WorkCard.astro';
import { services, work, answers } from '../data/site';
---

<Site
  title="Custom websites & hands-on tech help"
  description="Custom websites, dependable tech support and software you own. Little Fight NYC works with independent businesses. Start with a free conversation."
>
  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="label">
        <span class="signal-dot" aria-hidden="true"></span>Built for independent
        business
      </p>
      <h1 id="hero-title">
        YOUR BUSINESS.
        <br />A <span>BETTER</span>
        <br />
        WEBSITE.
      </h1>
      <p class="hero-description">
        We build custom websites and fix the technology behind the counter.
        Hands-on help for New York and beyond.
      </p>
      <div class="hero-actions">
        <a class="button" href="/contact/?service=websites">
          Plan my website <span aria-hidden="true">↗</span>
        </a>
        <span class="small-copy">The first conversation is free.</span>
      </div>
      <a class="urgent-link" href="/services/tech-support/">
        Something broken? Get tech help <span aria-hidden="true">→</span>
      </a>
    </div>
    <figure class="hero-photo">
      <img
        src="/images/shop-systems-hero.webp"
        srcset="/images/shop-systems-hero-480.webp 480w, /images/shop-systems-hero-800.webp 800w, /images/shop-systems-hero.webp 1440w"
        sizes="(max-width:600px) calc(100vw - 40px), 48vw"
        alt="The counter, payment terminal and working tools inside an independent shop."
        width="1440"
        height="901"
        fetchpriority="high"
      />
      <figcaption>
        <span class="label">In your corner</span>
        <strong>
          SMALL CREW.
          <br />
          HEAVY PULL.
        </strong>
        <span>
          For the businesses
          <br />
          that keep a city moving.
        </span>
      </figcaption>
      <span class="photo-index" aria-hidden="true">
        LF / NYC
      </span>
    </figure>
  </section>
  <div class="promise-strip shell">
    <p>
      <span aria-hidden="true">↗</span> Consulting is always free.
    </p>
    <p>
      <span aria-hidden="true">↗</span> Your code. Your accounts. Yours.
    </p>
    <p>
      <span aria-hidden="true">↗</span> Websites nationwide. NYC on site.
    </p>
  </div>
  <section class="section shell" aria-labelledby="work-heading">
    <div class="section-heading">
      <div>
        <p class="label">See what that looks like</p>
        <h2 id="work-heading">
          REAL BUSINESSES.
          <br />
          WORKING WEBSITES.
        </h2>
      </div>
      <a class="text-link" href="/work/">
        See our work <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="work-grid">
      {work.slice(0, 2).map((project) => (
        <WorkCard project={project} />
      ))}
    </div>
    <p class="evidence-caption">
      Public client websites · Captured October 9, 2026
    </p>
  </section>
  <section
    class="services-section section shell"
    aria-labelledby="services-heading"
  >
    <div class="section-heading">
      <div>
        <p class="label">Make the next move clear</p>
        <h2 id="services-heading">
          WHAT’S GETTING
          <br />
          IN YOUR WAY?
        </h2>
      </div>
      <p class="section-intro">
        Start with the part of your day that should work better. We’ll meet you
        there.
      </p>
    </div>
    <div class="service-list">
      {services.map((service) => (
        <a class="service-row" href={`/services/${service.slug}/`}>
          <span class="service-number">{service.number}</span>
          <div>
            <h3>{service.name}</h3>
            <p>{service.short}</p>
          </div>
          <span class="service-detail">
            {service.slug === 'websites'
              ? 'A clear path from first impression to your next customer.'
              : service.slug === 'tech-support'
                ? 'Computers, email, Wi-Fi and the tools behind your business.'
                : 'Focused tools that fit the way your business works.'}
          </span>
          <span class="service-arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      ))}
    </div>
  </section>
  <section
    class="approach-section section shell"
    aria-labelledby="approach-heading"
  >
    <div class="approach-visual">
      <img
        src="/images/counter-pos.webp"
        srcset="/images/counter-pos-480.webp 480w, /images/counter-pos-800.webp 800w, /images/counter-pos.webp 900w"
        sizes="(max-width:600px) calc(100vw - 40px), 46vw"
        alt="A card reader beside a tip jar on a small business counter."
        width="900"
        height="600"
        loading="lazy"
      />
      <div class="ownership-stamp">
        <img src="/brand/mark-white.svg" alt="" width="64" height="43" />
        <span>
          BUILT WITH YOU.
          <br />
          OWNED BY YOU.
        </span>
      </div>
    </div>
    <div>
      <p class="label">Small crew. Direct answers.</p>
      <h2 id="approach-heading">
        THE TECH FITS
        <br />
        YOUR BUSINESS.
      </h2>
      <p class="reading">
        We look at what you already have. Keep what works. Fix what gets in the
        way. Build something focused when the usual tools stop fitting.
      </p>
      <ol class="steps">
        <li>
          <span>01</span>
          <div>
            <h3>Talk it through.</h3>
            <p>You explain the business. We ask useful questions.</p>
          </div>
        </li>
        <li>
          <span>02</span>
          <div>
            <h3>See it working.</h3>
            <p>Review a real working version before launch.</p>
          </div>
        </li>
        <li>
          <span>03</span>
          <div>
            <h3>Keep the keys.</h3>
            <p>Your code, data, domain and instructions stay yours.</p>
          </div>
        </li>
      </ol>
      <a class="text-link" href="/about/">
        Meet Little Fight <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
  <section class="section shell faq-section" aria-labelledby="answers-heading">
    <div>
      <p class="label">A few straight answers</p>
      <h2 id="answers-heading">
        BEFORE
        <br />
        WE TALK.
      </h2>
      <a class="text-link" href="/answers/">
        All the answers <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="faq-list">
      {[answers[1], answers[4], answers[5], answers[6]].map((answer) => (
        <details>
          <summary>
            {answer.q}
            <span aria-hidden="true">+</span>
          </summary>
          <p>{answer.a}</p>
        </details>
      ))}
    </div>
  </section>
  <ContactBand />
</Site>
