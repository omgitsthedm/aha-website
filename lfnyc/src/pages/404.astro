---
import Site from '../layouts/Site.astro';
---

<Site
  title="Page not found"
  description="This page is not part of the Little Fight NYC preview. Find the homepage, website services or a direct path to help."
>
  <section class="not-found shell">
    <p class="label">404 · A missing page</p>
    <h1>
      LET’S GET YOU
      <br />
      BACK ON COURSE.
    </h1>
    <p>
      This address does not have a page here. The homepage has our services and
      work, or you can tell us what you need.
    </p>
    <div class="result-actions">
      <a class="button" href="/">
        Back to home <span aria-hidden="true">↗</span>
      </a>
      <a class="button button-secondary" href="/contact/">
        Get help <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</Site>
