---
const {
  heading = 'Show us what you’re working with.',
  text = 'A website, a broken device, or an idea that keeps coming back. Start with a free conversation.',
} = Astro.props;
---

<section class="contact-band shell" aria-labelledby="next-step-heading">
  <div>
    <p class="label">A real person in your corner</p>
    <h2 id="next-step-heading">{heading}</h2>
    <p>{text}</p>
  </div>
  <a class="button" href="/contact/">
    Get a free first look <span aria-hidden="true">↗</span>
  </a>
</section>
