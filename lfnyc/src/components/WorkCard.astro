---
import type { work } from '../data/site';
interface Props {
  project: (typeof work)[number];
}
const { project } = Astro.props;
---

<article class="work-card">
  <a
    class="work-image"
    href={project.href}
    aria-label={`Visit ${project.name} website`}
  >
    <img
      src={`/images/${project.image}`}
      srcset={`/images/${project.image.replace('.webp', '-480.webp')} 480w, /images/${project.image.replace('.webp', '-800.webp')} 800w, /images/${project.image} 1008w`}
      sizes="(max-width:600px) calc(100vw - 40px), (max-width:850px) 46vw, 48vw"
      alt={`${project.name} public website, captured October 9, 2026.`}
      width="1008"
      height="700"
      loading="lazy"
      decoding="async"
    />
    <span class="round-link" aria-hidden="true">
      ↗
    </span>
  </a>
  <p class="label">{project.kind}</p>
  <h3>
    <a href={project.story}>{project.name}</a>
  </h3>
  <p>{project.description}</p>
  <a class="text-link" href={project.story}>
    Read the published story <span aria-hidden="true">↗</span>
  </a>
</article>
