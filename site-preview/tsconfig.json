{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "test-results",
    ".server",
    "server/legacy-entry.mjs",
    "server/legacy-data.ts"
  ],
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true
  }
}
