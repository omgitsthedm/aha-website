{
  "name": "aha-preview",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 48378",
    "build": "node scripts/guard-build.mjs && astro build && node scripts/finalize.mjs",
    "preview": "node scripts/serve.mjs",
    "typecheck": "astro check",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.1",
    "@typescript-eslint/parser": "8.71.1",
    "axe-core": "4.14.0",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "typescript": "6.0.3"
  }
}
