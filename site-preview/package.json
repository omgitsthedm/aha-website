{
  "name": "aha-preview",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 48378",
    "build": "node scripts/guard-build.mjs && node scripts/bundle-services.mjs && astro build && node scripts/finalize.mjs",
    "preview": "node scripts/serve.mjs",
    "typecheck": "node scripts/bundle-services.mjs && astro check",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "report:metrics": "node scripts/metrics-report.mjs",
    "check:launch": "node scripts/launch-readiness.mjs",
    "format:check": "prettier --plugin=prettier-plugin-astro --check \"server/**/*.{ts,mjs}\" \"netlify/functions/*.mts\" \"src/**/*.{astro,ts,css}\" \"scripts/*.mjs\" \"tests/**/*.{ts,mjs}\""
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@netlify/database": "2.0.1",
    "@netlify/functions": "6.0.3",
    "astro": "7.4.4",
    "drizzle-orm": "1.0.0-rc.4",
    "web-push": "3.6.7",
    "web-vitals": "6.2.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@netlify/database-dev": "1.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.1",
    "@typescript-eslint/parser": "8.72.1",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3"
  }
}
