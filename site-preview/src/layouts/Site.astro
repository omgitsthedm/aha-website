---
import { imageUrl, imageSrcset } from '../../server/catalog/image-urls.mjs';
import "../styles/storefront.css";
import ProductTools from "../components/ProductTools.astro";
import Navigation from "../components/Navigation.astro";
import avif from "../data/avif.json";
import socialCards from "../data/social-cards.json";
import { answers, brand } from "../data/site";
import Consent from '../components/Consent.astro';
import EmailSignup from '../components/EmailSignup.astro';
interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  preloadImage?: { src: string; srcset: string; sizes: string };
}
const { title, description, path = Astro.url.pathname, noindex = false, image, imageAlt, imageWidth=1200, imageHeight=660, preloadImage } = Astro.props;
const origin = Astro.site!.origin;
const canonical = new URL(path, origin).href;
const isPreview = import.meta.env.AHA_PRODUCTION_BUILD !== "approved";
const card = (socialCards as Record<string, {src: string; alt: string; width: number; height: number}>)[path];
const fallbackCard = socialCards['/'];
const shareImage = new URL(card?.src ?? image ?? fallbackCard.src, origin).href;
const shareAlt = card?.alt ?? imageAlt ?? fallbackCard.alt;
const shareWidth = card?.width ?? (image ? imageWidth : fallbackCard.width);
const shareHeight = card?.height ?? (image ? imageHeight : fallbackCard.height);
// One sign-up form per page: Home and Updates have their own, and the bag and order
// pages stay clear. Every product page shares this footer (the live renderer reuses
// it), so the form reports the section of the site, not the exact page.
const footerSignup = ["/", "/updates/", "/checkout/", "/order/"].includes(path) ? null : (path.split("/").filter(Boolean)[0] ?? "site").replace(/[^a-z0-9-]/g, "-").slice(0, 40);
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${brand.official}/#organization`,
      name: brand.name,
      url: brand.official,
      logo: `${origin}/brand/sheep.svg`,
      email: brand.email,
      description:
        "Independent clothing, established in 2011. Graphic fleece, crewnecks and cropped hoodies.",
      founder: { "@type": "Person", name: "David Marsh" },
      foundingDate: "2011",
      sameAs: [brand.instagram,brand.facebook],
    },
    {
      "@type": "WebSite",
      "@id": `${origin}/#website`,
      url: `${origin}/`,
      name: brand.name,
      publisher: { "@id": `${brand.official}/#organization` },
      inLanguage: "en-US",
    },
    {
      "@type": path === "/about/" ? "AboutPage" : path === "/contact/" ? "ContactPage" : path === "/faq/" ? "FAQPage" : "WebPage",
      "@id": canonical,
      url: canonical,
      name: title,
      description,
      isPartOf: { "@id": `${origin}/#website` },
      about: { "@id": `${brand.official}/#organization` },
      inLanguage: "en-US",
      ...(path === "/faq/" ? { mainEntity: answers.map((item) => ({ "@type": "Question", name: item.q, acceptedAnswer: { "@type": "Answer", text: item.a } })) } : {}),
    },
    ...(path !== "/"
      ? [
          {
            "@type": "BreadcrumbList",
            itemListElement: [
              {
                "@type": "ListItem",
                position: 1,
                name: "Home",
                item: `${origin}/`,
              },
              {
                "@type": "ListItem",
                position: 2,
                name: title,
                item: canonical,
              },
            ],
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{title} | After Hours Agenda</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={
        (isPreview || noindex)
          ? "noindex, noarchive"
          : "index, follow, max-image-preview:large"
      }
    />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#FF6B6B" />
    <meta name="color-scheme" content="light" />
    {['poppins-latin-400', 'poppins-latin-700', 'poppins-latin-900', 'jetbrains-mono-400'].map(font => <link rel="preload" href={`/fonts/${font}.woff2`} as="font" type="font/woff2" crossorigin="anonymous" />)}
    {preloadImage && <link rel="preload" as="image" href={imageUrl((avif as Record<string, string>)[preloadImage.src] ? preloadImage.src.replace(/\.webp$/, ".avif") : preloadImage.src)} type={(avif as Record<string, string>)[preloadImage.src] ? "image/avif" : undefined} imagesrcset={imageSrcset((avif as Record<string, string>)[preloadImage.src] ?? preloadImage.srcset)} imagesizes={preloadImage.sizes} fetchpriority="high" />}
    <meta name="facebook-domain-verification" content="83wsdo81kg6b428satufegpkljq0w6" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={`${title} | After Hours Agenda`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={shareImage}
    />
    <meta property="og:image:type" content={shareImage.endsWith('.webp') ? 'image/webp' : 'image/jpeg'} />
    <meta property="og:image:width" content={String(shareWidth)} />
    <meta property="og:image:height" content={String(shareHeight)} />
    <meta
      property="og:image:alt"
      content={shareAlt}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | After Hours Agenda`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image:alt" content={shareAlt} />
    <meta
      name="twitter:image"
      content={shareImage}
    />
    <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
    <link
      rel="icon"
      href="/brand/favicon-32.png"
      sizes="32x32"
      type="image/png"
    />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {/* Supporting browsers start loading a product page when a visitor hovers or presses its link. */}
    <script type="speculationrules" is:inline set:html={`{"prerender":[{"where":{"and":[{"href_matches":"/shop/*"},{"not":{"href_matches":"/shop/"}}]},"eagerness":"moderate"}],"prefetch":[{"where":{"and":[{"href_matches":"/*"},{"not":{"href_matches":["/shop/*","/admin/*","/api/*","/checkout/*"]}}]},"eagerness":"moderate"}]}`} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema).replace(/</g, "\\u003c")}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    {isPreview && (
      <div class="preview-note">
        <span>After Hours Agenda · Website preview</span>
        <span>For review · Fall / Winter 2026</span>
      </div>
    )}
    <Navigation path={path} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer shell">
      {footerSignup && (
        <div class="footer-signup">
          <EmailSignup source={footerSignup} label="Get new drops by email" />
        </div>
      )}
      <div class="footer-links">
        <nav aria-label="Explore">
          <span class="label">Explore</span>
          <a href="/about/">The story</a>
          <a href="/lookbook/">Lookbook</a>
          <a href="/updates/">Updates</a>
          <a href="/shop/">Shop it all</a>
          <a href={brand.giftCards}>Gift cards </a>
        </nav>
        <nav aria-label="Support">
          <span class="label">Here to help</span>
          <a href="/contact/">Contact</a>
          <a href="/faq/">Common questions</a>
          <a href="/track-order/">Existing orders</a>
          <a href="/shipping/">Shipping</a>
          <a href="/returns/">Returns</a>
          <a href="/size-guide/">Size and fit</a>
          <a href="/care/">Care</a>
        </nav>
        <div>
          <p class="label">A real conversation</p>
          <a class="footer-email" href={`mailto:${brand.email}`}>
            {brand.email}
          </a>
          <p>
            Questions about fit, shipping or an order? We’re here to help.
          </p>
          <a href={brand.instagram}>Instagram </a>
          <a href={brand.facebook}>Facebook </a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>© 2026 After Hours Agenda</p>
        <nav aria-label="Policies">
          <a href="/privacy/">Privacy</a>
          <a href="/terms/">Terms</a>
          <a href="/accessibility/">Accessibility</a>
          <button type="button" class="privacy-button" data-privacy-settings>Privacy choices</button>
        </nav>
        <a class="creator-credit" href="https://littlefightnyc.com/">
          <img src="/brand/little-fight-nyc-tugboat-orange.svg" width="27" height="18" alt="" loading="lazy" />
          <span>created by <strong>Little Fight NYC</strong></span>
        </a>
      </div>
    </footer>
    {path.startsWith("/shop/") && path !== "/shop/" && <ProductTools />}
    <Consent />
    <script src="../scripts/cart-count.ts"></script>

  </body>
</html>
