---
import manifest from "../data/images.json";
import placeholders from "../data/placeholders.json";
interface Props {
  name: keyof typeof manifest;
  alt: string;
  sizes?: string;
  priority?: boolean;
}
const {
  name,
  alt,
  sizes = "(max-width: 760px) 100vw, 50vw",
  priority = false,
} = Astro.props;
const image = manifest[name];
const tone = (placeholders as Record<string, string[]>)[image.src];
---

<img
  src={image.src}
  srcset={image.srcset}
  sizes={sizes}
  width={image.width}
  height={image.height}
  alt={alt}
  loading={priority ? "eager" : "lazy"}
  fetchpriority={priority ? "high" : "auto"}
  decoding="async"
  style={tone ? `background:linear-gradient(${tone[0]},${tone[1]})` : undefined}
/>
