---
// A campaign photo that can carry its collection's short film. Without one it is exactly
// ProductImage. With one, the photo still loads first; the film is added after page load,
// never for reduced motion, Data Saver or 2G, and has a pause button.
import ProductImage from './ProductImage.astro';
import { motionFor } from '../data/motion';
interface Props {
  image: {src:string; srcset:string; alt:string; width:number; height:number};
  priority?: boolean;
  motionKey?: string;
  sizes?: string;
  /** Shown full-screen on phones (the lookbook): use the film cut for that crop. */
  tall?: boolean;
}
const {image,priority=false,sizes,tall=false,motionKey}=Astro.props;
const motion = motionFor(motionKey ?? image.src);
---
{motion ? <div class="motion-frame" data-motion={motion.large} data-motion-small={tall ? motion.tall : motion.small}><ProductImage image={image} priority={priority} sizes={sizes} /></div> : <ProductImage image={image} priority={priority} sizes={sizes} />}
<script>import "../scripts/motion";</script>
