<template id="bag-content"><div class="bag-panel-head"><p class="label" id="bag-panel-title">Added to your bag</p><button type="button" class="bag-panel-close" aria-label="Close" data-close>×</button></div><div class="bag-panel-item"><img alt="" width="72" height="90"><p><strong></strong><span></span><span></span></p></div><p class="bag-panel-total"><span></span><strong></strong></p><p class="bag-panel-arrival"></p><a class="button bag-panel-checkout" href="/checkout/">Checkout </a><button type="button" class="text-button" data-close>Keep shopping</button></template>
<template id="photo-content"><button type="button" class="photo-viewer-close" aria-label="Close">×</button><div class="photo-viewer-frame"><img alt=""></div></template>
<template id="fit-content"><form method="dialog" class="fit-form"><div class="fit-head"><h2 id="fit-title">Compare measurements</h2><button type="button" class="bag-panel-close" aria-label="Close" data-fit-close>×</button></div><p>Lay a top that fits you well flat. Measure straight across the chest, an inch below the armholes, and from the top of the shoulder to the hem.</p><fieldset class="fit-units"><legend>Measurement unit</legend><label><input type="radio" name="unit" value="in" checked> Inches</label><label><input type="radio" name="unit" value="cm"> Centimeters</label></fieldset><div class="fit-fields"><label>Chest width <span data-fit-unit>inches</span><input name="chest" type="number" inputmode="decimal" min="12" max="40" step="0.25" required></label><label>Body length <span data-fit-unit>inches</span><input name="length" type="number" inputmode="decimal" min="16" max="40" step="0.25" required></label></div><p class="fit-result" role="status" data-fit-result></p><div class="fit-actions"><button type="submit" class="button">Compare measurements</button><button type="button" class="button button-secondary" data-fit-select hidden></button><button type="button" class="text-button" data-fit-forget hidden>Forget my measurements</button></div><p class="fit-privacy">Saved only in this browser.</p></form></template>
<style is:global>
  .fit-units{display:flex;gap:1rem;margin:0;padding:0;border:0;font-size:.8rem;font-weight:700}.fit-units legend{position:absolute;inline-size:1px;block-size:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}.fit-units label{display:flex;align-items:center;gap:.4rem;min-height:40px}.fit-units input{accent-color:var(--ink)}
  .photo-viewer-controls,.photo-viewer-thumbnails{position:fixed;z-index:1;display:flex;gap:.5rem}.photo-viewer-controls{bottom:1rem;left:1rem}.photo-viewer-controls button,.photo-viewer-thumbnails button{min-height:44px;border:1px solid var(--ink);background:var(--paper);color:var(--ink);font:700 .7rem var(--mono);cursor:pointer}.photo-viewer-controls button{padding:.5rem .75rem}.photo-viewer-controls button:disabled{opacity:.45;cursor:not-allowed}.photo-viewer-thumbnails{right:1rem;bottom:1rem}.photo-viewer-thumbnails button{width:44px;padding:0}.photo-viewer-thumbnails button[aria-current="true"]{outline:3px solid var(--accent);outline-offset:2px}.photo-viewer-thumbnails img{display:block;width:100%;height:42px;object-fit:contain}@media(max-width:760px){.photo-viewer-controls{bottom:5rem}.photo-viewer-thumbnails{right:.75rem;bottom:.75rem;max-width:calc(100vw - 1.5rem);overflow:auto}.photo-viewer-thumbnails button{flex:none}}
</style>
