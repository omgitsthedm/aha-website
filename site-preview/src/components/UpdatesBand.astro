---
import EmailSignup from "./EmailSignup.astro";
interface Props { source: string }
const { source } = Astro.props;
---
<section class="updates-band" aria-labelledby="updates-title">
  <div class="shell updates-inner">
    <div>
      <p class="label">The next chapter</p>
      <h2 id="updates-title">Stay close.</h2>
      <p>
        New pieces by email, now and then. Or <a href="/contact/">talk to us</a> about choosing your fit.
      </p>
    </div>
    <EmailSignup source={source} label="Get new drops by email" />
  </div>
</section>
