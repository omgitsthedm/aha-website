---
import Site from '../layouts/Site.astro';
import products from '../data/products.json';
---
<Site title="Your bag" description="Review your After Hours Agenda selections, confirm delivery details and pay securely with Square." noindex>
  <section class="shell checkout-page" data-checkout-page>
    <header class="checkout-heading">
      <p class="label">Your selections</p>
      <h1>YOUR BAG.</h1>
      <p class="lede">Choose your sizes, confirm delivery, then pay securely with Square. Domestic shipping is free.</p>
    </header>
    <p class="checkout-message" data-checkout-message aria-live="polite" hidden></p>
    <button class="text-button checkout-status-check" type="button" data-check-payment-status hidden>Check payment status</button>
    <section class="bag-layout" aria-label="Bag and checkout">
      <div>
        <div class="bag-lines" data-cart-lines></div>
        <div class="bag-empty" data-cart-empty>
          <p class="label">Nothing selected yet</p>
          <h2>Find your next piece.</h2>
          <a class="button" href="/shop/">Shop the collection <span aria-hidden="true">↗</span></a>
        </div>
        <div class="cart-subtotal" data-cart-subtotal>$0.00</div>
      </div>
      <section class="checkout-panel" data-checkout-panel aria-labelledby="checkout-title" hidden>
        <p class="label">Secure checkout</p>
        <h2 id="checkout-title">Delivery &amp; payment</h2>
        <p class="checkout-note">We only use these details to price, pay for and deliver this order.</p>
        <form data-checkout-form novalidate>
          <fieldset>
            <legend>Contact</legend>
            <div class="checkout-fields two-up">
              <label>First name<input name="firstName" autocomplete="given-name" required /></label>
              <label>Last name<input name="lastName" autocomplete="family-name" required /></label>
            </div>
            <label>Email<input name="email" type="email" autocomplete="email" required /></label>
            <label>Phone <span class="field-optional">optional</span><input name="phone" type="tel" autocomplete="tel" /></label>
          </fieldset>
          <fieldset>
            <legend>Shipping address</legend>
            <label>Address<input name="addressLine1" autocomplete="address-line1" required /></label>
            <label>Apartment, suite, etc. <span class="field-optional">optional</span><input name="addressLine2" autocomplete="address-line2" /></label>
            <div class="checkout-fields address-row">
              <label>City<input name="city" autocomplete="address-level2" required /></label>
              <label>State / province<input name="region" autocomplete="address-level1" required /></label>
              <label>Postal code<input name="postalCode" autocomplete="postal-code" required /></label>
            </div>
            <label>Country<select name="country" autocomplete="country" required><option value="US">United States</option><option value="AU">Australia</option><option value="AT">Austria</option><option value="BE">Belgium</option><option value="CA">Canada</option><option value="CZ">Czechia</option><option value="DK">Denmark</option><option value="FI">Finland</option><option value="FR">France</option><option value="DE">Germany</option><option value="GR">Greece</option><option value="IE">Ireland</option><option value="IT">Italy</option><option value="JP">Japan</option><option value="NL">Netherlands</option><option value="NO">Norway</option><option value="PL">Poland</option><option value="PT">Portugal</option><option value="ES">Spain</option><option value="SE">Sweden</option><option value="CH">Switzerland</option><option value="TR">Türkiye</option><option value="GB">United Kingdom</option></select></label>
          </fieldset>
          <button class="button quote-button" type="submit" data-quote>Confirm total <span aria-hidden="true">→</span></button>
        </form>
        <div class="quote-summary" data-checkout-summary hidden aria-live="polite">
          <div><span>Items</span><strong data-quote-subtotal></strong></div>
          <div><span data-quote-shipping-label>Shipping</span><strong data-quote-shipping></strong></div>
          <div><span data-quote-tax-label>Tax</span><strong data-quote-tax></strong></div>
          <div class="quote-total"><span>Total</span><strong data-quote-total></strong></div>
        </div>
        <section class="payment-section" aria-labelledby="payment-title">
          <h3 id="payment-title">Payment</h3>
          <p class="checkout-note" data-card-status>Confirm your address to load secure payment options.</p>
          <div id="aha-card" class="square-field" aria-label="Secure card details"></div>
          <button type="button" class="button pay-button" data-pay-card disabled>Pay securely <span aria-hidden="true">↗</span></button>
          <div class="wallets" data-wallets hidden aria-label="Other secure payment options">
            <p class="label">Or choose another payment option</p>
            <button type="button" class="apple-pay-button" data-apple-pay aria-label="Pay with Apple Pay" hidden><span aria-hidden="true"> Pay</span></button>
            <div id="aha-google-pay"></div>
            <div id="aha-afterpay"></div>
            <div id="aha-cash-app"></div>
          </div>
        </section>
      </section>
    </section>
    {products.flatMap(product => product.variants.map(variant => <template data-cart-catalog data-id={variant.id} data-sku={variant.sku} data-size={variant.size} data-slug={product.slug} data-title={`${product.title} — ${product.color}`} data-price-cents={product.price*100} data-image={product.gallery[0]!.src} data-image-alt={product.gallery[0]!.alt}></template>))}
    <noscript><p class="checkout-message">JavaScript is needed to keep a bag and complete secure checkout. <a href="/shop/">Browse the current pieces</a>.</p></noscript>
  </section>
</Site>
<script src="../scripts/cart.ts"></script>
