---
import Site from "../layouts/Site.astro";
---

<Site
  title="Secure checkout"
  description="Review your shipping details and final After Hours Agenda order total before using secure payment."
  noindex
>
  <header class="page-head shell">
    <p class="label">Clear totals. Secure payment.</p>
    <h1>
      MAKE IT
      <br />
      <span class="accent">YOURS.</span>
    </h1>
    <p id="checkout-state" class="lede">
      New orders are paused while the next collection is developed.
    </p>
  </header>
  <section class="shell collection-section">
    <div class="actions" id="checkout-closed">
      <a class="button" href="/updates/">
        Join the release list ↗
      </a>
      <a class="text-link" href="/bag/">
        Back to your bag →
      </a>
    </div>
    <form id="checkout-form" class="brief-form" hidden>
      <fieldset id="shipping-fields">
        <legend>Shipping details</legend>
        <div class="checkout-fields">
          <div class="field">
            <label for="checkout-name">Full name *</label>
            <input
              id="checkout-name"
              name="name"
              required
              maxlength="100"
              autocomplete="shipping name"
            />
          </div>
          <div class="field">
            <label for="checkout-email">Email *</label>
            <input
              id="checkout-email"
              name="email"
              type="email"
              required
              maxlength="160"
              autocomplete="email"
            />
          </div>
          <div class="field full-width">
            <label for="checkout-address">Address *</label>
            <input
              id="checkout-address"
              name="address1"
              required
              maxlength="160"
              autocomplete="shipping address-line1"
            />
          </div>
          <div class="field full-width">
            <label for="checkout-address2">
              Apartment, suite or floor (optional)
            </label>
            <input
              id="checkout-address2"
              name="address2"
              maxlength="100"
              autocomplete="shipping address-line2"
            />
          </div>
          <div class="field">
            <label for="checkout-city">City *</label>
            <input
              id="checkout-city"
              name="city"
              required
              maxlength="100"
              autocomplete="shipping address-level2"
            />
          </div>
          <div class="field">
            <label for="checkout-state-input">State *</label>
            <input
              id="checkout-state-input"
              name="state"
              required
              maxlength="2"
              minlength="2"
              autocomplete="shipping address-level1"
            />
          </div>
          <div class="field">
            <label for="checkout-zip">ZIP code *</label>
            <input
              id="checkout-zip"
              name="zip"
              required
              pattern="[0-9]{5}(-[0-9]{4})?"
              autocomplete="shipping postal-code"
              inputmode="numeric"
            />
          </div>
          <div class="field">
            <label for="checkout-country">Country</label>
            <select id="checkout-country" name="country">
              <option value="US">United States</option>
            </select>
          </div>
        </div>
        <button class="button" type="submit">
          Review final total ↗
        </button>
      </fieldset>
      <div id="checkout-review" class="checkout-summary" hidden>
        <h2>Your order total</h2>
        <div id="quote-lines"></div>
        <p id="quote-total"></p>
        <p>
          Review <a href="/shipping/">shipping</a> and{" "}
          <a href="/returns/">returns</a> before payment.
        </p>
        <div id="card-container"></div>
        <label class="checkbox-label">
          <input type="checkbox" id="accept-order" />
          <span>
            I have reviewed the final total and the{" "}
            <a href="/terms/">terms of purchase</a>.
          </span>
        </label>
        <button class="button" type="button" id="pay-button">
          Pay securely
        </button>
        <button
          class="button button-secondary"
          type="button"
          id="edit-shipping"
        >
          Edit shipping
        </button>
      </div>
      <p id="payment-status" role="status" tabindex="-1"></p>
    </form>
    <noscript>
      <p>
        Secure checkout requires JavaScript. <a href="/contact/">Contact us</a>{" "}
        for help.
      </p>
    </noscript>
  </section>
  <script>
    import "../scripts/checkout";
  </script>
</Site>
