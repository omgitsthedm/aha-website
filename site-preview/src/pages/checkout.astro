---
import Site from '../layouts/Site.astro';
import ProductCard from '../components/ProductCard.astro';
import products from '../data/products.json';
---
<Site title="Continue shopping" description="Review your Yikes selections and continue to a current product page. Choose size and quantity at secure Square checkout." noindex>
  <header class="page-head shell">
    <p class="label">Continue shopping</p>
    <h1>YOUR PICKS.</h1>
    <p class="lede">Checkout is available one garment at a time. Open a piece below, then choose your size and quantity at secure Square checkout.</p>
  </header>
  <section class="shell selection-review" aria-label="Recovered selections" hidden>
    <p class="selection-notice" id="selection-warning" hidden>We couldn’t recover every selection from this link. Check the pieces below and browse the shop for anything missing.</p>
    <div id="selection-lines"></div>
    <p class="selection-subtotal" id="selection-subtotal" hidden></p>
    <p id="selection-note" hidden>Your selection is shown here. Select these sizes and quantities again at Square checkout. Domestic shipping is free; applicable tax is calculated there.</p>
    <p id="selection-coupon" hidden></p>
    <a class="text-link" href="/shop/">Browse all pieces →</a>
  </section>
  <section class="shell product-grid selection-fallback" aria-label="Current products">
    {products.map(product => <ProductCard product={product} />)}
  </section>
  <div class="shell shop-end"><p>Need help with an order or a previous collection? <a href="/contact/">Contact us</a>.</p></div>
  {products.map(product => product.variants.map(variant =>
    <template data-selection-variant data-id={variant.id} data-sku={variant.sku} data-size={variant.size} data-slug={product.slug} data-title={product.title} data-price={product.price} data-image={product.gallery[0]!.src} data-alt={product.gallery[0]!.alt}></template>
  ))}
</Site>
<script>
  import { recoverSelection } from '../scripts/selection';
  const templates = Array.from(document.querySelectorAll<HTMLTemplateElement>('[data-selection-variant]'));
  const variants = templates.map(t => ({ id: t.dataset.id!, sku: t.dataset.sku!, size: t.dataset.size!, slug: t.dataset.slug!, title: t.dataset.title!, price: Number(t.dataset.price) }));
  const selection = recoverSelection(location.search, variants);
  const review = document.querySelector<HTMLElement>('.selection-review')!;
  const lines = document.querySelector<HTMLElement>('#selection-lines')!;
  const money = (amount: number) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(amount);
  if (selection.lines.length || selection.incomplete || selection.coupon) review.hidden = false;
  if (selection.incomplete) document.querySelector<HTMLElement>('#selection-warning')!.hidden = false;
  for (const line of selection.lines) {
    const item = document.createElement('article');
    item.className = 'selection-line';
    const template = templates.find(t => t.dataset.id === line.id)!;
    const image = document.createElement('img');
    image.src = template.dataset.image!;
    image.alt = template.dataset.alt!;
    image.width = 1122; image.height = 1402;
    const content = document.createElement('div');
    const heading = document.createElement('h2');
    heading.textContent = line.title;
    const details = document.createElement('p');
    details.textContent = `Bone · Size ${line.size} · Quantity ${line.quantity}`;
    const price = document.createElement('p');
    price.textContent = `${money(line.price)} each · ${money(line.price * line.quantity)}`;
    const link = document.createElement('a');
    const destination = new URL(`/shop/${line.slug}/`, location.origin);
    destination.searchParams.set('size', line.size);
    destination.searchParams.set('quantity', String(line.quantity));
    const search = new URLSearchParams(location.search);
    for (const name of ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term']) {
      const value = search.get(name);
      if (value && value.length < 150) destination.searchParams.set(name, value);
    }
    link.href = destination.pathname + destination.search;
    link.className = 'text-link';
    link.textContent = `Open ${line.title} →`;
    content.append(heading, details, price, link);
    item.append(image, content); lines.append(item);
  }
  if (selection.lines.length) {
    document.querySelector<HTMLElement>('.selection-fallback')!.hidden = true;
    const subtotal = document.querySelector<HTMLElement>('#selection-subtotal')!;
    subtotal.textContent = `Selection subtotal: ${money(selection.lines.reduce((sum, line) => sum + line.price * line.quantity, 0))}`;
    subtotal.hidden = false;
    document.querySelector<HTMLElement>('#selection-note')!.hidden = false;
  }
  if (selection.coupon) {
    const coupon = document.querySelector<HTMLElement>('#selection-coupon')!;
    coupon.textContent = `Promo code from your link: ${selection.coupon}. Enter it at Square checkout to check whether it applies. No discount has been applied here.`;
    coupon.hidden = false;
  }
</script>
<style>
  .selection-review { max-width: 960px; padding-bottom: 2rem; }
  .selection-review[hidden], .selection-fallback[hidden] { display: none; }
  .selection-review :global(.selection-line) { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 1.5rem; border-top: 1px solid var(--line); padding: 1.5rem 0; }
  .selection-review :global(.selection-line img) { width: 100%; height: auto; align-self: start; border: 1px solid var(--line); }
  .selection-review :global(h2) { font-size: 1.3rem; margin: 0 0 .5rem; }
  .selection-review :global(p) { font-size: .9rem; line-height: 1.7; }
  .selection-review :global(.text-link) { display: inline-flex; align-items: center; min-height: 44px; }
  .selection-notice { padding: 1rem; border-left: 3px solid var(--rose); background: var(--surface); }
  .selection-subtotal { border-top: 1px solid var(--line); padding-top: 1.5rem; font-weight: 700; }
  #selection-coupon { overflow-wrap: anywhere; }
  @media(max-width: 540px) { .selection-review :global(.selection-line) { grid-template-columns: 70px minmax(0, 1fr); gap: 1rem; } }
</style>
