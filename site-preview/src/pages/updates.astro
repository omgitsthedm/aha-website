---
import Site from "../layouts/Site.astro";
import CustomerForm from "../components/CustomerForm.astro";
---

<Site
  title="Stay close"
  description="Join the After Hours Agenda email list for collection news and brand notes. Choose to subscribe; leave the list at any time."
>
  <header class="page-head shell">
    <p class="label">The next chapter</p>
    <h1>
      GOOD THINGS.
      <br />
      <span class="accent">IN YOUR INBOX.</span>
    </h1>
    <p class="lede">New pieces, the occasional note, and what comes next.</p>
  </header>
  <div class="contact-layout shell">
    <div class="contact-options">
      <div class="contact-option">
        <h2>A little closer.</h2>
        <p>
          Leave your email for collection news and stories from After Hours
          Agenda. Signing up does not reserve a piece or create an order.
        </p>
      </div>
      <div class="contact-option">
        <h2>On your terms.</h2>
        <p>
          No release date has been announced. Unsubscribe whenever you like.
        </p>
        <a class="text-link" href="/unsubscribe/">
          Leave the list →
        </a>
      </div>
      <a class="text-link" href="https://www.instagram.com/afterhoursagenda">
        Follow on Instagram ↗
      </a>
    </div>
    <section class="brief-panel" aria-labelledby="signup-title">
      <h2 id="signup-title">Stay close.</h2>
      <CustomerForm kind="newsletter" />
    </section>
  </div>
</Site>
