---
import Site from "../../layouts/Site.astro";
import { pieces, launch, type Piece } from "../../data/catalog";
export function getStaticPaths() {
  return pieces.map((piece) => ({
    params: { slug: piece.slug },
    props: { piece },
  }));
}
const { piece } = Astro.props as { piece: Piece };
const schema =
  piece.status === "approved" && launch.releaseApproved && launch.policyApproved
    ? {
        "@type": "ProductGroup",
        name: piece.title,
        description: piece.description,
        productGroupID: piece.slug,
        brand: { "@type": "Brand", name: "After Hours Agenda" },
        variesBy: ["https://schema.org/size", "https://schema.org/color"],
        hasVariant: piece.variants.map((v) => ({
          "@type": "Product",
          name: `${piece.title} — ${v.color} / ${v.size}`,
          sku: v.id,
          size: v.size,
          color: v.color,
          image: piece.images.map((src) => new URL(src, Astro.site).href),
          offers: {
            "@type": "Offer",
            url: new URL(`/pieces/${piece.slug}/?variant=${v.id}`, Astro.site)
              .href,
            price: (v.price / 100).toFixed(2),
            priceCurrency: "USD",
            availability: `https://schema.org/${v.available > 0 ? "InStock" : "OutOfStock"}`,
          },
        })),
      }
    : undefined;
---

<Site
  title={piece.title}
  description={piece.description}
  productSchema={schema}
>
  <div class="shell product-breadcrumb">
    <a href="/shop/">Collection</a>
    <span aria-hidden="true">/</span>
    <span>{piece.title}</span>
  </div>
  <section class="shell product-layout">
    <div class="product-gallery">
      {piece.images.map((src, i) => (
        <figure>
          <a
            href={src}
            aria-label={`Open ${piece.title} image ${i + 1} at full size`}
          >
            <img
              src={src}
              width="1536"
              height="1024"
              alt={`${piece.title} garment development mockup, showing ${piece.colors.join(" and ")}`}
              loading={i ? "lazy" : "eager"}
            />
          </a>
          <figcaption>{piece.imageNote}</figcaption>
        </figure>
      ))}
    </div>
    <div class="product-details">
      <p class="label">
        {piece.category} /{" "}
        {piece.status === "development" ? "In development" : "Collection"}
      </p>
      <h1>{piece.title}</h1>
      <p class="lede">{piece.description}</p>
      <p class="label">Color direction</p>
      <ul class="color-list">
        {piece.colors.map((color) => (
          <li>{color}</li>
        ))}
      </ul>
      {piece.status === "development" ? (
        <div class="availability-note">
          <strong>This piece is still taking shape.</strong>
          <p>
            Final fabric, sizes, price and availability will follow approved
            samples. This is not a reservation.
          </p>
          <a class="button" href="/updates/">
            Tell me when there’s news ↗
          </a>
        </div>
      ) : (
        <form data-add-to-bag>
          <label for="variant">Color and size</label>
          <select id="variant" name="variant" required>
            <option value="">Choose a size</option>
            {piece.variants.map((v) => (
              <option value={v.id} disabled={!v.available}>
                {v.color} / {v.size} — ${(v.price / 100).toFixed(2)}
                {v.available ? "" : " — unavailable"}
              </option>
            ))}
          </select>
          <button class="button" type="submit">
            Add to bag ↗
          </button>
          <p role="status" data-bag-feedback></p>
        </form>
      )}
      <button
        class="button button-secondary"
        type="button"
        data-save={piece.slug}
        aria-pressed="false"
      >
        Save this piece
      </button>
      <p data-storage-feedback role="status" class="small-copy"></p>
      <div class="product-accordions">
        <details open>
          <summary>Material and construction</summary>
          <p>{piece.material}</p>
        </details>
        <details>
          <summary>Size and fit</summary>
          <p>{piece.fit}</p>
          <a href="/size-guide/" class="text-link">
            How to measure →
          </a>
          {piece.measurements?.length && (
            <table>
              <caption>Garment measurements in inches</caption>
              <thead>
                <tr>
                  <th>Size</th>
                  <th>Chest</th>
                  <th>Length</th>
                </tr>
              </thead>
              <tbody>
                {piece.measurements.map((row) => (
                  <tr>
                    <th>{row.size}</th>
                    <td>{row.chest}</td>
                    <td>{row.length}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </details>
        <details>
          <summary>Care</summary>
          <p>{piece.care}</p>
          <a href="/care/" class="text-link">
            Care help →
          </a>
        </details>
        <details>
          <summary>Shipping and returns</summary>
          <p>
            New orders are paused. Existing purchases retain the shipping and
            return terms shown at checkout.
          </p>
          <a class="text-link" href="/shipping/">
            Shipping help →
          </a>
          <br />
          <a class="text-link" href="/returns/">
            Returns and exchanges →
          </a>
        </details>
      </div>
      <a class="text-link" href="/contact/?topic=product">
        A question about this piece? →
      </a>
    </div>
  </section>
</Site>
