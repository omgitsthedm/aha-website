---
import Site from "../layouts/Site.astro";
import UpdatesBand from "../components/UpdatesBand.astro";
const tenets = [
  [
    "Work hard. Love hard.",
    "Make time for an idea you keep putting off. Make time for the people beside you, too. There is a life to build after the work is done.",
  ],
  [
    "Celebrate.",
    "A birthday gives you a reason to get together. So does a dinner after a long day. Leave a little room for both.",
  ],
  [
    "Be kind.",
    "Make room for someone else. Kindness belongs in the small choices we make with people every day.",
  ],
  [
    "Find your people.",
    "The black sheep has its own way of doing things. There is still room beside it for a friend.",
  ],
];
---

<Site
  title="The manifesto"
  description="The After Hours Agenda manifesto: work hard, love hard, be kind, find your people and celebrate the life you are building."
>
  <header class="page-head shell manifesto-hero">
    <div>
      <p class="label">The things we come back to</p>
      <h1>
        BUILD A LIFE.
        <br />
        <span class="accent">LIVE IT WELL.</span>
      </h1>
      <p class="lede">
        For the dreamers and the doers. For kindness. For the community.
      </p>
    </div>
    <img
      src="/brand/sheep.svg"
      width="220"
      height="173"
      alt="The After Hours Agenda black sheep"
    />
  </header>
  <div class="shell reading">
    {tenets.map(([title, body]) => (
      <section>
        <h2>{title}</h2>
        <p>{body}</p>
      </section>
    ))}
  </div>
  <UpdatesBand />
</Site>
