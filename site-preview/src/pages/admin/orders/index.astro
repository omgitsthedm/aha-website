---
import Admin from "../../../layouts/Admin.astro";
---
<Admin title="Orders" page="orders">
  <p class="admin-meta">Paid orders, their Apliiq status and tracking. Receipt and hold actions require a recorded reason. Support messages are visible only after admin sign-in.</p>
  <div class="admin-filters" role="group" aria-label="Filter orders">
    <button type="button" class="admin-secondary" data-order-filter="all" aria-pressed="true">All</button>
    <button type="button" class="admin-secondary" data-order-filter="attention" aria-pressed="false">Needs attention</button>
  </div>
  <div class="admin-list" data-admin-orders aria-live="polite"></div>
  <h2 style="margin-block: 2.5rem 1rem">Support requests</h2>
  <div class="admin-list" data-admin-support aria-live="polite"></div>
</Admin>
