---
import Site from '../../layouts/Site.astro';
import ProductCard from '../../components/ProductCard.astro';
import { collectionCopy, collectionId, collectionSlug, collectionsInOrder } from '../../data/collections';
import { GARMENT_GROUPS, garmentGroup } from '../../../server/catalog/garments.mjs';
import { allOffSale } from '../../../server/catalog/off-sale.mjs';
const collections = collectionsInOrder().filter(([, pieces]) => pieces.length);
// Filter buttons need script (src/scripts/live-shop.ts), so they start hidden.
const garmentFilters = GARMENT_GROUPS.filter((group) => collections.some(([, pieces]) => pieces.some((product) => garmentGroup(product.typeLabel) === group.key)));
---
<Site title="Shop Fall / Winter 2026" description="Shop the Fall / Winter 2026 After Hours Agenda collection. Each product page has finished-garment measurements and four product views. Free domestic shipping.">
  <header class="page-head shell shop-heading"><p class="label">Fall / Winter 2026</p><h1>THE COLLECTION.</h1><p class="lede">Made-to-order pieces, each with finished-garment measurements and its own fit details.</p><p class="status-copy">Free domestic shipping. Prices stay the same across sizes.</p><div class="type-filter" role="group" aria-label="Show" data-type-filter hidden><button type="button" aria-pressed="true" data-filter="all">All</button>{garmentFilters.map((group) => <button type="button" aria-pressed="false" data-filter={group.key}>{group.label}</button>)}</div><nav class="collection-jump" aria-label="Jump to a collection">{collections.map(([collection, pieces]) => <a href={`#${collectionId(collection)}`} data-jump={collectionId(collection)} hidden={allOffSale(pieces)}>{collection}</a>)}</nav></header>
  <section class="shell collection-group" data-live-products hidden aria-labelledby="collection-just-added"><div class="section-header"><div><p class="label">Fall / Winter 2026</p><h2 id="collection-just-added">Just added</h2><p class="collection-copy">New pieces, ready to order now.</p></div></div><div class="product-grid" data-live-grid></div></section>
  {collections.map(([collection, pieces]) => <section class="shell collection-group" aria-labelledby={collectionId(collection)} hidden={allOffSale(pieces)}><div class="section-header"><div><p class="label">Fall / Winter 2026</p><h2 id={collectionId(collection)}>{collection}</h2><p class="collection-copy">{collectionCopy(collection)}</p></div><a class="text-link" href={`/shop/${collectionSlug(collection)}/`}>The collection →</a></div><div class="product-grid">{pieces.map(product=><ProductCard product={product}/>)}</div></section>)}
  <section class="shell shop-end"><p>See each piece in context.</p><a class="text-link" href="/lookbook/">Explore the lookbook →</a></section>
</Site>
<script src="../../scripts/live-shop.ts"></script>
