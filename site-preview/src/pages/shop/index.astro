---
import Site from '../../layouts/Site.astro';
import ProductCard from '../../components/ProductCard.astro';
import products from '../../data/products.json';
import { GARMENT_GROUPS, garmentGroup, garmentsInOrder } from '../../../server/catalog/garments.mjs';
const pieces = garmentsInOrder(products);
const isLightLayer = (product: typeof products[number]) => ['cropped-hoodies', 'tees'].includes(garmentGroup(product.typeLabel));
const garmentFilters = GARMENT_GROUPS.filter(group => pieces.some(product => garmentGroup(product.typeLabel) === group.key));
---
<Site title="Shop all clothing" description="Shop graphic tees, hoodies, crewnecks, long sleeves and ribbed beanies. Choose your fit with garment measurements, four product views and free U.S. shipping.">
  <header class="page-head shell shop-heading"><p class="label">Fall / Winter 2026</p><h1>YOUR NEXT FAVORITE.</h1><p class="lede">Graphic tees, soft fleece and ribbed knitwear. Find the cut and color that feel like you.</p><p class="status-copy">Free U.S. shipping. One price across sizes.</p><div class="type-filter" role="group" aria-label="Show" data-type-filter hidden><button type="button" aria-pressed="true" data-filter="all">All pieces</button>{garmentFilters.map(group => <button type="button" aria-pressed="false" data-filter={group.key}>{group.label}</button>)}</div><form class="shop-search" role="search" action="/shop/"><label for="shop-query">Find a garment, color or design</label><input id="shop-query" name="q" type="search" autocomplete="off" placeholder="Search the pieces" /></form><p class="shop-result-status" role="status" data-shop-status></p></header>
  <section class="shell collection-group shop-garments" aria-label="All garments"><div class="product-grid" data-shop-grid="light">{pieces.filter(isLightLayer).map(product => <ProductCard product={product} />)}</div><div class="product-grid" data-shop-grid="layers">{pieces.filter(product => !isLightLayer(product)).map(product => <ProductCard product={product} />)}</div></section>
  <section class="shell shop-end"><p>See how it’s worn.</p><a class="text-link" href="/lookbook/">Explore the lookbook</a></section>
</Site>
<script src="../../scripts/live-shop.ts"></script>
<noscript><style is:inline>#main [data-type-filter][hidden]{display:none!important}</style></noscript>
<style>.shop-garments{display:grid;gap:34px}.type-filter[hidden]{display:flex!important;visibility:hidden}@media(max-width:760px){.shop-garments{gap:28px}}</style>
