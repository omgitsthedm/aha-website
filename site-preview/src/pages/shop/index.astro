---
import Site from '../../layouts/Site.astro';
import ProductCard from '../../components/ProductCard.astro';
import products from '../../data/products.json';
const availableCollections = [...new Set(products.map((product) => product.collection))];
const collectionOrder = [
  ...['The City', 'Insomniac', 'Yikes!'].filter((collection) => availableCollections.includes(collection)),
  ...availableCollections.filter((collection) => !['The City', 'Insomniac', 'Yikes!'].includes(collection)),
];
const collections = collectionOrder
  .map((collection) => [collection, products.filter((product) => product.collection === collection)] as const)
  .filter(([, pieces]) => pieces.length);
const collectionCopy: Record<string, string> = {
  'The City': 'Black fleece and cotton jersey with a blue-and-orange back print and a plain front.',
  Insomniac: 'Long-sleeve layers with a front chest mark and a full back sketch.',
  'Yikes!': 'Bone fleece in two cuts with a yellow-and-blue chest graphic.',
};
---
<Site title="Shop Fall / Winter 2026" description="Shop the Fall / Winter 2026 After Hours Agenda collection. Each product page has finished-garment measurements and four product views. Free domestic shipping.">
  <header class="page-head shell shop-heading"><p class="label">Fall / Winter 2026</p><h1>THE COLLECTION.</h1><p class="lede">Made-to-order pieces, each with finished-garment measurements and its own fit details.</p><p class="status-copy">Free domestic shipping. Prices stay the same across sizes.</p></header>
  {collections.map(([collection, pieces]) => <section class="shell collection-group" aria-labelledby={`collection-${collection.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}><div class="section-header"><div><p class="label">Fall / Winter 2026</p><h2 id={`collection-${collection.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>{collection}</h2><p class="collection-copy">{collectionCopy[collection] ?? 'Current pieces from the Fall / Winter 2026 collection.'}</p></div></div><div class="product-grid">{pieces.map(product=><ProductCard product={product}/>)}</div></section>)}
  <section class="shell shop-end"><p>See each piece in context.</p><a class="text-link" href="/lookbook/">Explore the lookbook →</a></section>
</Site>
