---
import Site from '../../layouts/Site.astro';
import ProductCard from '../../components/ProductCard.astro';
import products from '../../data/products.json';
import { GARMENT_GROUPS, garmentGroup, garmentsInOrder } from '../../../server/catalog/garments.mjs';
const pieces = garmentsInOrder(products);
const isLightLayer = (product: typeof products[number]) => ['cropped-hoodies', 'tees'].includes(garmentGroup(product.typeLabel));
const garmentFilters = GARMENT_GROUPS.filter(group => pieces.some(product => garmentGroup(product.typeLabel) === group.key));
const sizes = [...new Set(pieces.flatMap(product => product.variants.map((variant: typeof product.variants[number]) => variant.size)))];
const colors = [...new Set(pieces.map(product => product.color))].sort((a, b) => a.localeCompare(b));
---
<Site title="Shop all clothing" description="Shop graphic tees, hoodies, crewnecks, long sleeves and ribbed beanies. Choose your fit with garment measurements, four product views and free U.S. shipping.">
  <header class="page-head shell shop-heading"><p class="label">Fall / Winter 2026</p><h1>YOUR NEXT FAVORITE.</h1><p class="lede">Graphic tees, soft fleece and ribbed knitwear. Find the cut and color that feel like you.</p><p class="status-copy">Free U.S. shipping. One price across sizes.</p><div class="type-filter" role="group" aria-label="Show" data-type-filter hidden><button type="button" aria-pressed="true" data-filter="all">All pieces</button>{garmentFilters.map(group => <button type="button" aria-pressed="false" data-filter={group.key}>{group.label}</button>)}</div><form class="shop-search" role="search" action="/shop/"><label for="shop-query">Find a garment, color or design</label><input id="shop-query" name="q" type="search" autocomplete="off" placeholder="Search the pieces" /></form><div class="shop-refine" data-shop-refine hidden><fieldset data-size-filter><legend>Size</legend><button type="button" aria-pressed="true" data-size="all">All sizes</button>{sizes.map(size => <button type="button" aria-pressed="false" data-size={size}>{size}</button>)}</fieldset><label>Color <select data-color-filter><option value="all">All colors</option>{colors.map(color => <option value={color}>{color}</option>)}</select></label><button type="button" class="text-button" data-shop-reset hidden>Clear filters</button></div><p class="shop-result-status" role="status" data-shop-status></p></header>
  <section class="shell collection-group shop-garments" aria-label="All garments"><div class="product-grid" data-shop-grid="light">{pieces.filter(isLightLayer).map(product => <ProductCard product={product} />)}</div><div class="product-grid" data-shop-grid="layers">{pieces.filter(product => !isLightLayer(product)).map(product => <ProductCard product={product} />)}</div></section>
  <section class="shell shop-end"><p>See how it’s worn.</p><a class="text-link" href="/lookbook/">Explore the lookbook</a></section>
</Site>
<script src="../../scripts/live-shop.ts"></script>
<noscript><style is:inline>#main [data-type-filter][hidden]{display:none!important}</style></noscript>
<style>.shop-garments{display:grid;gap:34px}.type-filter[hidden],.shop-refine[hidden]{display:flex!important;visibility:hidden}.shop-refine{align-items:end;gap:1rem;flex-wrap:wrap;margin-top:1rem}.shop-refine fieldset{display:flex;flex-wrap:wrap;gap:.4rem;margin:0;padding:0;border:0}.shop-refine legend{font:700 .75rem var(--mono);letter-spacing:.04em;text-transform:uppercase;margin-bottom:.4rem}.shop-refine button,.shop-refine select{min-height:44px;padding:.45rem .75rem;border:1px solid var(--ink);background:var(--paper);color:var(--ink);font:700 .75rem var(--mono);cursor:pointer}.shop-refine button[aria-pressed="true"]{background:var(--ink);color:var(--paper)}.shop-refine label{display:grid;gap:.4rem;font:700 .75rem var(--mono);letter-spacing:.04em;text-transform:uppercase}.shop-refine .text-button{border:0;text-transform:none;text-decoration:underline}.shop-refine select{font:400 .85rem var(--body);letter-spacing:0;text-transform:none}.shop-refine button:focus-visible,.shop-refine select:focus-visible{outline:3px solid var(--accent);outline-offset:2px}:global(.is-color-variant){display:none!important}:global(.color-family){display:flex;align-items:center;gap:.45rem;flex-wrap:wrap;margin:.35rem 0 0;font-size:.75rem;color:var(--muted)}:global(.color-family a){display:inline-flex;align-items:center;justify-content:center;min-width:24px;min-height:24px;border:1px solid var(--line)}:global(.color-family a:focus-visible){outline:3px solid var(--accent);outline-offset:2px}:global(.color-family span){width:14px;height:14px;background:var(--swatch);border:1px solid var(--control)}@media(max-width:760px){.shop-garments{gap:28px}.shop-refine{align-items:stretch}.shop-refine fieldset{flex:1 1 100%;min-width:0;min-inline-size:0;flex-wrap:nowrap;max-width:100%;overflow-x:auto;padding-bottom:.2rem}.shop-refine button{flex:none}}</style>
