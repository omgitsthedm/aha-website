---
import Site from '../../layouts/Site.astro';
import ProductImage from '../../components/ProductImage.astro';
import ProductCard from '../../components/ProductCard.astro';
import products from '../../data/products.json';
import { measurementGuide, otherColors, swatchFor } from '../../../server/catalog/garments.mjs';
import { dropFor, dropNote, dropStage } from '../../../server/catalog/drops.mjs';
import { isOffSale } from '../../../server/catalog/off-sale.mjs';
import { RETURN_POLICY, SHIPPING_DETAILS } from '../../../server/catalog/offer-terms.mjs';
export function getStaticPaths(){return products.map(product=>({params:{product:product.slug},props:{product}}));}
const {product}=Astro.props;
const origin=Astro.site!.origin;
const gallery = product.gallery.slice(0, 4);
const galleryLabels: Record<string, string> = { front: 'Front', back: 'Back', 'print-detail': 'Print detail', folded: 'Folded' };
const relatedProducts = [
 ...products.filter((entry) => entry.slug !== product.slug && entry.collection === product.collection),
 ...products.filter((entry) => entry.slug !== product.slug && entry.collection !== product.collection),
].slice(0, 4);
const colorSwatch = swatchFor(product.color);
const siblings: typeof products = otherColors(product, products);
const drop = dropStage(dropFor(product.slug)) === 'released' ? null : dropFor(product.slug);
// Off sale (src/data/off-sale.json): kept for Restore to sale, but not indexed and not offered.
const offSale = isOffSale(product.slug);
const productSchema={
 '@context':'https://schema.org','@type':'ProductGroup',name:`${product.title} — ${product.color}`,description:product.description,
 productGroupID:product.squareItemId,brand:{'@type':'Brand',name:'After Hours Agenda'},color:product.color,material:product.composition,
 image:gallery.map(i=>new URL(i.feedImage,origin).href),variesBy:['https://schema.org/size'],
 hasVariant:product.variants.map(v=>({'@type':'Product',name:`${product.title} — ${product.color} — ${v.size}`,sku:v.sku,size:v.size,color:product.color,image:new URL(gallery[0]!.feedImage,origin).href,
 offers:{'@type':'Offer',url:`${origin}/shop/${product.slug}/?size=${encodeURIComponent(v.size)}`,price:product.price,priceCurrency:'USD',availability:offSale?'https://schema.org/Discontinued':'https://schema.org/InStock',itemCondition:'https://schema.org/NewCondition',seller:{'@type':'Organization',name:'After Hours Agenda'},shippingDetails:SHIPPING_DETAILS,hasMerchantReturnPolicy:RETURN_POLICY}}))
};
---
<Site title={`${product.title} — ${product.color}`} description={product.description} image={gallery[0]!.feedImage} imageAlt={gallery[0]!.alt} imageWidth={gallery[0]!.width} imageHeight={gallery[0]!.height} noindex={offSale} preloadImage={{src:gallery[0]!.src,srcset:gallery[0]!.srcset,sizes:'(max-width: 760px) 100vw, 55vw'}}>
 <div class="shell product-breadcrumb"><a href="/shop/"> All pieces</a><span>Fall / Winter 2026</span></div>
 <section class="shell product-layout" data-product-id={product.squareItemId} data-product-name={product.title} data-product-color={product.color} data-product-price={product.price}>
  <div class="product-visuals">
   <div class="product-gallery" role="region" tabindex="0" aria-label={`${product.title} garment views; scroll to see all four`}>
    {gallery.map((shot,i)=><figure id={`view-${i+1}`}><ProductImage image={shot} priority={i===0} sizes="(max-width: 760px) 100vw, 55vw" name={i===0 ? `p-${product.slug}` : undefined}/><figcaption>{galleryLabels[shot.role]}</figcaption></figure>)}
   </div>
   <p class="image-note">Product mockups. Colors and print placement can vary slightly in production.</p>
  </div>
  <div class="product-details">
   <p class="label">{product.collection} / {product.typeLabel}</p><h1>{product.title}</h1>
   <div class="product-price-row"><p class="product-price">${product.price}<span> USD</span></p><p>Free domestic shipping</p></div>
   <div class="arrival" data-arrival><p>Made to order: production takes about a week, then shipping.</p></div>
   {drop && <p class="drop-note" data-drop data-early={drop.earlyAccessAt} data-release={drop.releaseAt}>{dropNote(drop)}</p>}
   <p class="color-choice"><span class="color-swatch" style={`--swatch:${colorSwatch}`} aria-hidden="true"></span> {product.color}</p>
   {siblings.length > 0 && <p class="color-options">Also in {siblings.map((entry) => <a class="color-option" href={`/shop/${entry.slug}/`}><span class="color-swatch" style={`--swatch:${swatchFor(entry.color)}`} aria-hidden="true"></span> {entry.color}</a>)}</p>}
   <p>{product.description}</p>
   <form class="product-purchase" data-cart-form>
    <div class="size-head"><p class="label">Choose a size</p><button type="button" class="text-button fit-open" data-fit-open hidden>Find my size</button></div>
    <div class="size-options" role="radiogroup" aria-label={`${product.title} size`} aria-required="true">
     {product.variants.map(v=><label><input type="radio" name="size" value={v.id} data-cart-variant data-size={v.size} data-sku={v.sku}/><span>{v.size}</span></label>)}
    </div>
    <label class="quantity-field">Quantity <input data-cart-quantity name="quantity" type="number" min="1" max="10" step="1" value="1" inputmode="numeric" /></label>
    <button type="submit" class="button add-to-bag">Add to bag <span aria-hidden="true">+</span></button>
    <button type="submit" class="button button-secondary buy-now" data-buy-now>Buy now </button>
    <button type="button" class="text-button save-piece" data-save={product.slug} aria-pressed="false" hidden>Save for later</button>
    <p class="cart-add-status" data-cart-add-status aria-live="polite"></p>
    <div class="express-pay" data-express hidden><p class="label">Or pay now</p><button type="button" class="apple-pay-button" data-express-apple aria-label="Buy with Apple Pay" hidden><span aria-hidden="true"> Pay</span></button><div id="aha-express-google" data-express-google></div><p class="checkout-note" data-express-status aria-live="polite"></p></div>
   </form>
   <a class="text-link size-link" href="#size-guide">Check measurements </a>
   <p class="checkout-note">Free domestic shipping. Final tax and payment options are shown securely at checkout.</p>
   <details open><summary>Fit &amp; fabric</summary><ul class="product-facts"><li>{product.fit}.</li>{product.typeLabel !== "Beanie" && <li>{product.weightOz} oz {product.fabricType}.</li>}<li>{product.composition}.</li>{product.constructionDetails.map((detail) => <li>{detail}</li>)}{product.blank && <li>Blank: {product.blank}.</li>}<li>{product.typeLabel === "Beanie" ? "Embroidered" : "Printed"} to order in the United States{product.printMethod ? `, ${product.printMethod}` : ""}.</li></ul></details>
   <details><summary>Shipping &amp; returns</summary><p>Made to order. Production usually takes about a week; shipping time varies by destination. Domestic shipping is free.</p><p>Request a return within 30 days of delivery for an unworn, unwashed item. Contact us before sending anything back.</p><p><a href="/shipping/">Shipping details</a> · <a href="/returns/">Return policy</a></p></details>
   <details><summary>Care</summary><p>Follow the label on your garment. Where permitted, wash cold and inside out. Do not iron directly on the {product.typeLabel === "Beanie" ? "embroidery" : "print"}.</p></details>
  </div>
 </section>
 <Fragment set:html={measurementGuide(product)} />
 <section class="shell section reviews" id="reviews" aria-labelledby="reviews-title" data-reviews={product.slug} hidden><p class="label">From people who bought it</p><h2 id="reviews-title">Reviews.</h2><p class="reviews-summary" data-review-summary></p><ul class="review-list" data-review-list></ul></section>
 <section class="section shell"><div class="section-header"><h2>More pieces.</h2><a href="/shop/" class="text-link">Shop all </a></div><div class="product-grid related-products">{relatedProducts.map(p=><ProductCard product={p}/>)}</div></section>
 {products.flatMap(entry=>entry.variants.map(variant=><template data-cart-catalog data-id={variant.id} data-sku={variant.sku} data-size={variant.size} data-slug={entry.slug} data-title={`${entry.title} — ${entry.color}`} data-color={entry.color} data-price-cents={entry.price*100} data-image={entry.gallery[0]!.src} data-image-alt={entry.gallery[0]!.alt}></template>))}
 <script type="application/ld+json" set:html={JSON.stringify(productSchema).replace(/</g,'\\u003c')}/>
 <script>
  const search=new URLSearchParams(location.search);
  const requested=search.get('size');
  const quantity=Number(search.get('quantity'));
  const option=[...document.querySelectorAll<HTMLInputElement>('[data-cart-variant]')].find(el=>el.dataset.size===requested);
  const amount=document.querySelector<HTMLInputElement>('[data-cart-quantity]');
  if(option){option.checked=true;if(amount&&Number.isInteger(quantity)&&quantity>=1&&quantity<=10)amount.value=String(quantity);}
 </script>
</Site>
<script src="../../scripts/cart.ts"></script>
