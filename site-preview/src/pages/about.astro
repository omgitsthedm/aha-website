---
import Site from "../layouts/Site.astro";
import Image from "../components/EditorialImage.astro";
// The manifesto lives here; /manifesto/ redirects to #manifesto (scripts/finalize.mjs).
const tenets = [
  [
    "Work hard. Love hard.",
    "Work matters. So do the small wins, the time together and the ideas you keep coming back to. Make time for the people beside you, too.",
  ],
  [
    "Celebrate.",
    "A birthday gives you a reason to get together. So does a dinner after a long day. Leave a little room for both.",
  ],
  [
    "Be kind.",
    "We make clothes for good people: kind to the people who wear them, the people who make them and the people they’re given to. Kindness belongs in the small choices we make every day.",
  ],
  [
    "Find your people.",
    "A brand is the people wearing it: friends, families, the person you love and the ones you look after. There’s room for all of them here.",
  ],
];
---

<Site
  title="The story"
  description="The After Hours Agenda story and manifesto, from the original 2012 Prologue to a clothing brand built on kindness, community and the life you’re building."
>
  <header class="page-head shell">
    <p class="label">After Hours Agenda · Est. 2011</p>
    <h1>
      BUILT ON
      <br />
      <span class="accent">KINDNESS.</span>
    </h1>
  </header>
  <section class="about-intro shell">
    <div>
      <p class="lede">
        We make clothes for the people and the ideas you love, and for the work
        it takes to build them.
      </p>
      <p>
        In January 2012, the first site opened with a typed page called The
        Prologue. “We are dreamers,” it said. “We create, and we build.” That is
        the thread running through the brand.
      </p>
      <p>
        Graphic tees, heavyweight hoods and crewnecks have carried that story.
        The black sheep is our signature: your own way of doing things, with
        good people beside you.
      </p>
      <p>
        Today, each collection brings its own graphics, one design at a time.
        The archive keeps the early pieces close.
      </p>
      <div class="actions">
        <a class="button" href="/lookbook/">
          See the lookbook ↗
        </a>
        <a class="text-link" href="/contact/">
          Get in touch →
        </a>
      </div>
    </div>
    <figure>
      <Image
        name="2012-the-prologue"
        alt="The typed January 2012 Prologue from the After Hours Agenda archive."
        priority
      />
      <figcaption class="image-caption">
        The actual 2012 Prologue · Brand archive
      </figcaption>
    </figure>
  </section>
  <section class="shell section manifesto" id="manifesto" aria-labelledby="manifesto-title">
    <div class="manifesto-head">
      <div>
        <p class="label">The manifesto</p>
        <h2 id="manifesto-title">
          BUILD A LIFE.
          <br />
          <span class="accent">LIVE IT WELL.</span>
        </h2>
        <p class="lede">
          For the dreamers and the doers. For kindness. For the community.
        </p>
      </div>
      <img src="/brand/sheep.svg" width="220" height="173" alt="" loading="lazy" />
    </div>
    {tenets.map(([title, text], index) => (
      <div class="values">
        <span class="label">0{index + 1}</span>
        <h3>{title}</h3>
        <p>{text}</p>
      </div>
    ))}
  </section>
</Site>
