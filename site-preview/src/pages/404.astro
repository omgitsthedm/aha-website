---
import Site from "../layouts/Site.astro";
---

<Site
  title="Page not found"
  description="This After Hours Agenda page is not available. Find the story, lookbook, current collection status or customer support."
>
  <section class="page-head shell">
    <p class="label">404 · Page not found</p>
    <h1>
      A DIFFERENT
      <br />
      <span class="accent">WAY BACK.</span>
    </h1>
  </section>
  <div class="empty-state shell">
    <p>
      This page is not available. Older product links may belong to the archived
      collection. New orders are paused, but the story, lookbook and support are
      here.
    </p>
    <div class="actions">
      <a class="button" href="/">
        Back to the start ↗
      </a>
      <a class="button button-secondary" href="/contact/">
        Get support
      </a>
    </div>
  </div>
</Site>
