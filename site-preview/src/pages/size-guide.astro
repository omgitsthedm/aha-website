---
import Site from "../layouts/Site.astro";
---

<Site
  title="Size and fit"
  description="Measure a garment you already like before comparing size charts. After Hours Agenda explains garment width, length and sleeves without guessing your size."
>
  <header class="page-head shell">
    <p class="label">Start with what fits</p>
    <h1>
      YOUR FIT.
      <br />
      <span class="accent">YOUR WAY.</span>
    </h1>
    <p class="lede">
      The most useful reference is a piece you already love wearing.
    </p>
  </header>
  <section class="shell fit-layout">
    <div class="fit-diagram">
      <svg viewBox="0 0 500 480" role="img" aria-labelledby="fit-title">
        <title id="fit-title">A flat garment: measure across the chest from armpit to armpit, and from shoulder to hem for length.</title>
        <path
          d="M170 80L100 105 35 200 110 245 140 210 140 405 360 405 360 210 390 245 465 200 400 105 330 80Q250 150 170 80Z"
          fill="#FAFAFA"
          stroke="#1A1A1A"
          stroke-width="3"
        />
        <path
          d="M145 235H355M310 115V397"
          fill="none"
          stroke="#CE3D56"
          stroke-width="3"
          stroke-dasharray="8 6"
        />
        <text
          x="250"
          y="222"
          text-anchor="middle"
          font-family="Poppins, sans-serif"
          font-size="18"
        >
          CHEST WIDTH
        </text>
        <text
          x="298"
          y="335"
          text-anchor="end"
          font-family="Poppins, sans-serif"
          font-size="18"
        >
          LENGTH
        </text>
      </svg>
      <p class="small-copy">
        Flat garment measurements. Body measurements are different.
      </p>
    </div>
    <div class="fit-steps">
      <h2>Three simple checks.</h2>
      <ol>
        <li>
          <strong>Lay it flat.</strong> Smooth a similar garment without
          stretching it.
        </li>
        <li>
          <strong>Measure across.</strong> For chest width, measure from armpit
          to armpit. Do not double this when comparing a flat-width chart.
        </li>
        <li>
          <strong>Measure down.</strong> Check length from the highest shoulder
          point to the hem, and compare the measuring method used on the product
          page.
        </li>
      </ol>
      <p>
        Existing pieces: use the label and original product chart. New
        collection measurements will appear on each product page after samples
        are approved.
      </p>
      <a class="text-link" href="/contact/?topic=product">
        Need a hand with fit? →
      </a>
    </div>
  </section>
  <section class="shell collection-section">
    <div class="measurement-tool">
      <div>
        <p class="label">A useful conversion</p>
        <h2>Inches or centimeters.</h2>
        <p>
          Convert your own measurement. This tool does not predict a clothing
          size.
        </p>
      </div>
      <form id="measure-form" class="brief-form">
        <div class="field">
          <label for="measurement">Your measurement</label>
          <input
            id="measurement"
            type="number"
            min="0.1"
            max="300"
            step="0.1"
            inputmode="decimal"
            value="20"
            required
          />
        </div>
        <div class="field">
          <label for="measure-unit">Measured in</label>
          <select id="measure-unit">
            <option value="in">Inches</option>
            <option value="cm">Centimeters</option>
          </select>
        </div>
        <output
          id="measure-result"
          for="measurement measure-unit"
          role="status"
        >
          20 inches = 50.8 centimeters
        </output>
      </form>
    </div>
  </section>
  <script>
    const form = document.querySelector<HTMLFormElement>("#measure-form")!;
    const value = document.querySelector<HTMLInputElement>("#measurement")!;
    const unit = document.querySelector<HTMLSelectElement>("#measure-unit")!;
    const output =
      document.querySelector<HTMLOutputElement>("#measure-result")!;
    function update() {
      const n = Number(value.value);
      output.value =
        !value.validity.valid || !n
          ? "Enter a measurement from 0.1 to 300."
          : unit.value === "in"
            ? `${n} inches = ${(n * 2.54).toFixed(1)} centimeters`
            : `${n} centimeters = ${(n / 2.54).toFixed(1)} inches`;
    }
    form.addEventListener("input", update);
    form.addEventListener("submit", (event) => event.preventDefault());
  </script>
</Site>
