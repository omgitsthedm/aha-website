---
import Site from "../layouts/Site.astro";
import { answers } from "../data/site";
---

<Site
  title="Collection status and order questions"
  description="Answers about Yikes sizing, made-to-order garments, free domestic shipping, returns and existing After Hours Agenda orders."
>
  <header class="page-head shell">
    <p class="label">A little clarity</p>
    <h1>
      QUESTIONS,
      <br />
      <span class="accent">ANSWERED.</span>
    </h1>
    <p class="lede">
      Find the measurements, shipping details and order help you need.
    </p>
  </header>
  <div class="shell reading">
    <div class="faq-list">
      {answers.map((item) => (
        <details>
          <summary>
            {item.q}
            <span aria-hidden="true">+</span>
          </summary>
          <p>{item.a}</p>
          <p><a href={item.href}>{item.label} →</a></p>
        </details>
      ))}
    </div>
    <p>
      Something else? <a href="/contact/">Talk to us</a>. For an existing order,
      include the order number and checkout email.
    </p>
  </div>
</Site>
