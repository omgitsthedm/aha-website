---
import Site from "../layouts/Site.astro";
import CustomerForm from "../components/CustomerForm.astro";
---

<Site
  title="Talk to us"
  description="Send After Hours Agenda a message about an existing order, a piece, fit or accessibility. Direct email support is also available."
>
  <header class="page-head shell">
    <p class="label">Real people. A real conversation.</p>
    <h1>
      TALK
      <br />
      <span class="accent">TO US.</span>
    </h1>
    <p class="lede">
      An order question, a piece you love, or something you need a hand with.
      Start here.
    </p>
  </header>
  <div class="contact-layout shell">
    <aside class="contact-options">
      <div class="contact-option">
        <p class="label">Write directly</p>
        <h2 class="contact-address">
          <a href="mailto:info@afterhoursagenda.com">
            info@afterhoursagenda.com ↗
          </a>
        </h2>
        <p>
          Use the form or your own email app. Support stays separate from the
          mailing list.
        </p>
      </div>
      <div class="contact-option">
        <p class="label">Already ordered?</p>
        <h2>A little less waiting.</h2>
        <p>
          Use your order number, checkout email and shipping ZIP code to look up
          an order.
        </p>
        <a class="text-link" href="/track-order/">
          Track an order →
        </a>
      </div>
      <div class="contact-option">
        <h2>Something not right?</h2>
        <p>
          Tell us about a return, a fit issue or a damaged piece. We will review
          the terms of your purchase.
        </p>
        <a class="text-link" href="/returns/">
          Start a return request →
        </a>
      </div>
      <div class="contact-option">
        <h2>Before you write.</h2>
        <a class="text-link" href="/faq/">
          Common questions →
        </a>
        <br />
        <a class="text-link" href="/size-guide/">
          Size and fit help →
        </a>
      </div>
    </aside>
    <section class="brief-panel" aria-labelledby="form-title">
      <h2 id="form-title">We’re listening.</h2>
      <p>
        Tell us what you need. For an existing order, use the email you checked
        out with.
      </p>
      <CustomerForm kind="support" />
    </section>
  </div>
</Site>
