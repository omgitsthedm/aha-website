---
import Site from "../layouts/Site.astro";
import { brand, topics } from "../data/site";
---

<Site
  title="Talk to us"
  description="Contact After Hours Agenda for help with an existing order, a piece, fit, returns or accessibility. Send a message or write to info@afterhoursagenda.com."
>
  <header class="page-head shell">
    <p class="label">Here to help</p>
    <h1>
      TALK
      <br />
      <span class="accent">TO US.</span>
    </h1>
    <p class="lede">
      Help with your fit, a garment detail or an existing order. Tell us what you need.
    </p>
  </header>
  <div class="contact-layout shell">
    <div>
      <div class="contact-options">
        <div class="contact-option">
          <p class="label">Write directly</p>
          <h2 class="contact-address">
            <a href={`mailto:${brand.email}`}>{brand.email} </a>
          </h2>
          <p>
            No form needed. Email us with a little context and we will take it
            from there.
          </p>
        </div>
        <div class="contact-option">
          <p class="label">For an existing order</p>
          <h2>A few useful details.</h2>
          <p>
            Include the order number and checkout email. For a fit question,
            tell us the product, size and color. For damage or an incorrect
            item, attach clear photos when you send your email.
          </p>
        </div>
        <div class="contact-option">
          <p class="label">Keep it safe</p>
          <p>
            Never include passwords, card numbers or security codes. Include
            your order number when asking about a purchase.
          </p>
          <a class="text-link" href="/faq/">
            Common questions
          </a>
        </div>
      </div>
    </div>
    <section class="brief-panel" aria-labelledby="brief-title">
      <h2 id="brief-title">A little context helps.</h2>
      <p>
        Send your question here and we’ll reply by email. Your message won’t add you to a mailing list.
      </p>
      <noscript>
        <p class="reading">
          Email{" "}
          <a class="text-link" href={`mailto:${brand.email}`}>
            {brand.email}
          </a>{" "}
          with your name, order number if relevant, and what you need help with.
        </p>
      </noscript>
      <form class="brief-form" id="brief-form" hidden novalidate>
        <div class="field">
          <label for="name">
            Your name <span aria-hidden="true">*</span>
          </label>
          <input
            id="name"
            name="name"
            autocomplete="name"
            required
            maxlength="80"
            aria-describedby="name-error"
          />
          <p class="field-error" id="name-error" hidden></p>
        </div>
        <div class="field">
          <label for="reference">
            Order number <span class="small-copy">(optional)</span>
          </label>
          <input
            id="reference"
            name="reference"
            autocomplete="off"
            maxlength="120"
          />
        </div>
        <div class="field">
          <label for="email">
            Your email <span aria-hidden="true">*</span>
          </label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            inputmode="email"
            required
            maxlength="160"
            aria-describedby="email-error"
          />
          <p class="field-error" id="email-error" hidden></p>
        </div>
        <div class="field">
          <label for="topic">What brings you here?</label>
          <select id="topic" name="topic">
            {topics.map((topic) => (
              <option value={topic.slug}>{topic.name}</option>
            ))}
          </select>
        </div>
        <div class="field">
          <label for="message">
            How can we help? <span aria-hidden="true">*</span>
          </label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            minlength="10"
            maxlength="1800"
            aria-describedby="message-help message-error"
            placeholder="An order update, a fit question, or something else…"
          ></textarea>
          <p class="field-help" id="message-help">
            A few sentences are enough. Keep passwords and payment details out.
          </p>
          <p class="field-error" id="message-error" hidden></p>
        </div>
        <p class="form-footnote">
          * Required. We use these details to answer your request.
        </p>
        <div hidden aria-hidden="true"><label>Company<input name="company" tabindex="-1" autocomplete="off" /></label></div>
        <button class="button" type="submit">
          Send message
        </button>
      </form>
      <div class="brief-result" id="brief-result" hidden>
        <h3 id="result-title" tabindex="-1">Your message has been received.</h3>
        <p>We’ll reply to the email address you provided. Keep an eye on your inbox.</p>
      </div>
      <p id="form-status" class="field-error" role="status"></p>
    </section>
  </div>
  <script>
    import { createBrief, validateBrief } from "../scripts/brief";
    const form = document.querySelector<HTMLFormElement>("#brief-form")!;
    const result = document.querySelector<HTMLElement>("#brief-result")!;
    const topic = document.querySelector<HTMLSelectElement>("#topic")!;
    const status = document.querySelector<HTMLElement>("#form-status")!;
    form.hidden = false;
    const requested = new URLSearchParams(location.search).get("topic");
    if (
      requested &&
      [...topic.options].some((option) => option.value === requested)
    )
      topic.value = requested;
    const requestId = crypto.randomUUID();
    let sending = false;
    type SupportChallenge = { token: string; earliestSubmitAt: string; expiresAt: string };
    async function requestChallenge(): Promise<SupportChallenge | null> {
      try {
        const response = await fetch("/api/support/challenge", {
          headers: { accept: "application/json", "x-aha-support": "1" },
          signal: AbortSignal.timeout(10_000),
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok || typeof data.token !== "string") return null;
        return data;
      } catch {
        return null;
      }
    }
    let challengePromise = requestChallenge();
    async function challengeForSubmit() {
      let challenge = await challengePromise;
      if (!challenge || Date.parse(challenge.expiresAt) <= Date.now()) {
        challengePromise = requestChallenge();
        challenge = await challengePromise;
      }
      if (!challenge) throw new Error("We couldn’t prepare the form. Try again or email us directly.");
      const wait = Date.parse(challenge.earliestSubmitAt) - Date.now();
      if (wait > 0) await new Promise((resolve) => setTimeout(resolve, wait));
      return challenge.token;
    }
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (sending) return;
      const values = Object.fromEntries(new FormData(form));
      const errors = validateBrief(values);
      for (const name of ["name", "email", "message"]) {
        const input = form.elements.namedItem(name) as HTMLInputElement;
        const error = document.getElementById(`${name}-error`)!;
        input.setAttribute("aria-invalid", String(Boolean(errors[name])));
        error.textContent = errors[name] || "";
        error.hidden = !errors[name];
      }
      const firstError = Object.keys(errors)[0];
      if (firstError) {
        status.textContent =
          "Check the marked fields. Your details are still here.";
        (form.elements.namedItem(firstError) as HTMLElement).focus();
        return;
      }
      status.textContent = "";
      const prepared = createBrief(values);
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      sending = true;
      button.disabled = true;
      button.textContent = "Sending…";
      try {
        const challenge = await challengeForSubmit();
        const response = await fetch("/api/support", {
          method: "POST", headers: { "content-type": "application/json", "x-aha-support": "1" },
          body: JSON.stringify({ ...values, requestId, challenge }), signal: AbortSignal.timeout(15_000),
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok || data.ok !== true) throw new Error(data.error || "We couldn’t confirm receipt. Your message is still here. Try again or email us directly.");
        form.hidden = true;
        result.hidden = false;
        document.getElementById("result-title")!.focus();
      } catch (error) {
        challengePromise = requestChallenge();
        status.textContent = error instanceof Error && error.name !== "TimeoutError" ? error.message : "We couldn’t confirm receipt. Your message is still here. Try again or email us directly.";
        let fallback = form.querySelector<HTMLAnchorElement>("[data-support-fallback]");
        if (!fallback) {
          fallback = document.createElement("a");
          fallback.dataset.supportFallback = "";
          fallback.className = "text-link";
          fallback.textContent = "Open this message in your email app";
          form.append(fallback);
        }
        fallback.href = prepared.url;
      } finally {
        sending = false;
        button.disabled = false;
        button.textContent = "Send message";
      }
    });
  </script>
</Site>
