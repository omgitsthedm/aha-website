---
import Site from "../layouts/Site.astro";
---

<Site
  title="Request received"
  description="Thank you for contacting After Hours Agenda. Find the collection, support and privacy information here."
  noindex
>
  <header class="page-head shell">
    <p class="label">Thank you</p>
    <h1>
      WE’VE GOT
      <br />
      <span class="accent">YOUR NOTE.</span>
    </h1>
    <p class="lede">
      If you just submitted a form, we have received it. Support replies go to
      the email address you provided.
    </p>
    <div class="actions">
      <a class="button" href="/">
        Back to the story ↗
      </a>
      <a class="text-link" href="/contact/">
        Contact us →
      </a>
    </div>
  </header>
</Site>
