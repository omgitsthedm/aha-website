---
import Site from "../layouts/Site.astro";
import Image from "../components/EditorialImage.astro";
import UpdatesBand from "../components/UpdatesBand.astro";
import ProductImage from '../components/ProductImage.astro';
import ProductCard from '../components/ProductCard.astro';
import products from '../data/products.json';
---

<Site
  title="Yikes! — Fall / Winter 2026"
  description="The Yikes! crewneck and cropped hoodie in Bone. Yellow-and-blue graphics on cotton-blend fleece. Shop After Hours Agenda with free domestic shipping."
>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="label">Independent clothing · Est. 2011</p>
      <h1>
        FOR THE
        <br />
        DREAMERS
        <br />
        <span>
          AND THE
          <br />
          DOERS.
        </span>
      </h1>
      <p class="lede">
        For good people who work hard, love hard, and celebrate the life they’re
        building.
      </p>
      <div class="actions">
        <a class="button" href="/shop/">
          Shop Yikes! <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="/about/">
          Our story →
        </a>
      </div>
      <p class="status-copy">
        Yikes! is here. Bone fleece, two cuts, free domestic shipping.
      </p>
    </div>
    <figure class="hero-image">
      <span class="image-number" aria-hidden="true">
        YIKES! / FALL–WINTER 2026
      </span>
      <ProductImage image={products[1]!.campaign[0]!} priority />
      <figcaption>
        Yikes! cropped hoodie · Campaign mockup · AI-generated
      </figcaption>
    </figure>
  </section>
  <div class="shell">
    <div class="chapter-strip">
      <span>Kindness. Community. A little individuality.</span>
      <span>For you and the people you love.</span>
    </div>
  </div>
  <section class="section shell" aria-labelledby="new-pieces"><div class="section-header"><div><p class="label">Fall / Winter 2026</p><h2 id="new-pieces">YIKES!</h2></div><a class="text-link" href="/shop/">Shop the collection →</a></div><div class="product-grid">{products.map(product=><ProductCard product={product}/>)}</div></section>
  <section class="section shell story-grid" aria-labelledby="story-title">
    <figure class="archive-image">
      <Image
        name="2012-the-prologue"
        alt="The original After Hours Agenda Prologue, typed on paper in January 2012."
      />
      <figcaption class="image-caption">
        The Prologue · Brand archive · January 2012
      </figcaption>
    </figure>
    <div>
      <p class="label">The first words still hold.</p>
      <h2 id="story-title">
        WE CREATE.
        <br />
        WE <span class="accent">BUILD.</span>
      </h2>
      <p>
        After hours is the part of the day that’s yours. The time you give to
        the people and the ideas you love, after the work is done.
      </p>
      <p>
        We wrote about dreamers, community and celebrating life in 2012. That is
        still who this is for.
      </p>
      <div class="actions">
        <a class="text-link" href="/about/">
          Read the story →
        </a>
        <a class="text-link" href="/manifesto/">
          The manifesto →
        </a>
      </div>
    </div>
  </section>
  <section class="section shell" aria-labelledby="lookbook-title">
    <div class="section-header">
      <div>
        <p class="label">The Yikes! campaign</p>
        <h2 id="lookbook-title">
          OUR OWN
          <br />
          <span class="accent">KIND OF GOOD.</span>
        </h2>
      </div>
      <a class="text-link" href="/lookbook/">
        See the lookbook →
      </a>
    </div>
    <div class="teaser-grid">
      <figure>
        <ProductImage image={products[0]!.campaign[0]!} />
        <figcaption>
          <h3>Yikes! Crewneck.</h3>
          <p>Bone · Campaign mockup · AI-generated</p>
        </figcaption>
      </figure>
      <figure>
        <ProductImage image={products[1]!.campaign[2]!} />
        <figcaption>
          <h3>Yikes! Cropped Hoodie.</h3>
          <p>Bone · Campaign mockup · AI-generated</p>
        </figcaption>
      </figure>
    </div>
  </section>
  <section class="shell section">
    <div class="statement">
      <img
        src="/brand/sheep.svg"
        width="260"
        height="204"
        alt="The After Hours Agenda black-sheep mark"
        loading="lazy"
      />
      <div>
        <p class="label">The Black Sheep</p>
        <h2>
          YOUR OWN WAY.
          <br />
          <span class="accent">GOOD COMPANY.</span>
        </h2>
        <p>
          The black sheep does things its own way and brings everyone along. For
          the people who make something of their time, and make room for one
          another.
        </p>
      </div>
    </div>
  </section>
  <UpdatesBand />
</Site>
