---
import Site from '../layouts/Site.astro';
import ProductImage from '../components/ProductImage.astro';
import ProductCard from '../components/ProductCard.astro';
import UpdatesBand from '../components/UpdatesBand.astro';
import products from '../data/products.json';
import { photosFor } from '../data/photography';
import { onSale } from '../../server/catalog/off-sale.mjs';
const active = onSale(products) as typeof products;
const piece = (slug: string) => active.find(product => product.slug === slug)!;
const nonna = piece('nonna-s-sunday-supper-society-c1717-ivory');
const fashion = piece('fashion-kills-3023cl-black');
const crop = piece('yikes-cropped-hoodie');
const record = piece('for-the-record-ss4500-black');
const beanies = active.filter(product => product.typeLabel === 'Beanie');
const selected = [nonna, crop, piece('mighty-micks-ss3000-navy'), beanies[0]!];
const categories = [
  { key: 'tees', title: 'Tees', text: 'Boxy or classic. Always your call.', product: fashion },
  { key: 'hoodies', title: 'Hoodies', text: 'A layer you’ll keep reaching for.', product: piece('camo-sheep-ind4000-forest-camo') },
  { key: 'crewnecks', title: 'Crewnecks', text: 'Easy over a tee. Good on its own.', product: piece('yikes-crewneck') },
  { key: 'long-sleeves', title: 'Long sleeves', text: 'A little more coverage.', product: active.find(p => p.collection === 'Resist Rebel' && p.typeLabel.toLowerCase().includes('long sleeve'))! },
];
const heroSizes = '(max-width:760px) calc((100vw - 24px) / 2), (max-width:1024px) calc((100vw - 36px) / 2), 34vw';
---
<Site title="Graphic tees, fleece and knitwear" description="Graphic tees, soft fleece and ribbed knitwear. Find your fit in the Fall / Winter 2026 collection, with free U.S. shipping and one price across sizes." preloadImage={{...photosFor(nonna)[0]!, sizes: heroSizes}}>
  <section class="hero-composition is-arriving" aria-labelledby="hero-heading">
    <div class="hero-photo hero-photo-left"><a class="photo-link" href={`/shop/${nonna.slug}/`}><ProductImage image={photosFor(nonna)[0]!} priority sizes={heroSizes} /><span class="photo-label"><strong>T-shirt · {nonna.color}</strong><span>${nonna.price} · View garment</span></span></a></div>
    <div class="hero-words"><p class="label">Fall / Winter 2026</p><h1 class="buyer-headline" id="hero-heading"><span>GET</span><span>COMFORTABLE</span><span>MAKING AN</span><span>IMPRESSION.</span></h1><p>Graphic tees, soft fleece and ribbed knitwear.</p><a class="button button-dark" href="/shop/">Shop it all</a><a class="quiet-link" href="/lookbook/">See how it’s worn</a></div>
    <div class="hero-photo hero-photo-right"><a class="photo-link" href={`/shop/${fashion.slug}/`}><ProductImage image={photosFor(fashion)[1] ?? photosFor(fashion)[0]!} priority sizes={heroSizes} /><span class="photo-label"><strong>Boxy tee · {fashion.color}</strong><span>${fashion.price} · View garment</span></span></a></div>
  </section>
  <div class="confidence-strip"><a href="/shipping/">Free U.S. shipping</a><a href="/size-guide/">One price, every size</a><a href="/returns/">30-day return requests</a></div>
  <section class="section shell" aria-labelledby="choose-heading"><div class="section-header"><div><p class="label">Find your fit</p><h2 id="choose-heading">WHAT WILL YOU WEAR?</h2></div><a class="text-link" href="/shop/">Shop it all</a></div><div class="category-grid">{categories.map(category => <a class="category" href={`/shop/?type=${category.key}`}><div class="category-photo"><ProductImage image={photosFor(category.product)[0]!} sizes="(max-width:760px) 45vw, 24vw" /></div><h3>{category.title}</h3><p>{category.text}</p></a>)}</div></section>
  <section class="section shell selected-pieces" aria-labelledby="selected-heading"><div class="section-header"><div><p class="label">Selected pieces</p><h2 id="selected-heading">TAKE A CLOSER LOOK.</h2></div><a class="text-link" href="/shop/">Shop all clothing</a></div><div class="product-grid home-selection">{selected.map(product => <ProductCard product={product} />)}</div><p class="fit-link">Between sizes? <a href="/size-guide/">Compare the measurements</a></p></section>
  <section class="wear-story shell" aria-labelledby="wear-heading"><a class="wear-story-main" href={`/shop/${crop.slug}/`} aria-label={`View ${crop.title}`}><ProductImage image={photosFor(crop)[1] ?? photosFor(crop)[0]!} sizes="(max-width:760px) 100vw, 55vw" /></a><div class="wear-story-side"><div class="wear-story-copy"><p class="label">Cropped fleece</p><h2 id="wear-heading">A SHORTER<br />SILHOUETTE.</h2><p>A raw cropped hem with a pleated skirt and a longer coat. Take a closer look at the proportions.</p><a class="text-link" href={`/shop/${crop.slug}/`}>See the cropped hoodie</a></div><a class="wear-story-detail" href={`/shop/${crop.slug}/`} aria-label={`Another view of ${crop.title}`}><ProductImage image={photosFor(crop)[2] ?? photosFor(crop)[0]!} sizes="(max-width:760px) 42vw, 32vw" /></a></div></section>
  <section class="section shell" aria-labelledby="knit-heading"><div class="section-header"><div><p class="label">Ribbed knitwear</p><h2 id="knit-heading">CHOOSE YOUR COLOR.</h2></div><a class="text-link" href="/shop/?type=beanies">All the colors</a></div><div class="beanie-strip">{beanies.filter(p => ['Black','Blaze Orange','Camel','Forest Green','Navy','White'].includes(p.color)).map(product => <a class="beanie-card" href={`/shop/${product.slug}/`}><ProductImage image={product.gallery[0]!} sizes="(max-width:760px) 37vw, 15vw" /><span>{product.color} · ${product.price}</span></a>)}</div></section>
  <section class="origin-band shell" aria-labelledby="record-heading"><div><p class="label">For the Record hoodie</p><h2 id="record-heading">FRONT<br />TO BACK.</h2><p>Small type at the chest. A redacted-document graphic across the back.</p><a class="button button-dark" href={`/shop/${record.slug}/`}>See the hoodie</a><a class="quiet-link" href="/about/">Independent clothing since 2011</a></div><a class="origin-photo" href={`/shop/${record.slug}/`} aria-label="View the For the Record hoodie"><ProductImage image={photosFor(record).at(-1)!} sizes="(max-width:760px) 100vw, 55vw" /></a></section>
  <p class="campaign-disclosure shell">Campaign imagery is AI-generated. <a href="/lookbook/">Explore the lookbook</a>. Product pages show garment views and measurements.</p>
  <UpdatesBand source="home" />
</Site>
<script>
  const hero = document.querySelector('.hero-composition');
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) hero?.classList.remove('is-arriving');
  else setTimeout(() => hero?.classList.remove('is-arriving'), 900);
</script>
<script src="../scripts/retired-cards.ts"></script>
