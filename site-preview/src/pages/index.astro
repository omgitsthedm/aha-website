---
import Site from "../layouts/Site.astro";
import Image from "../components/EditorialImage.astro";
import UpdatesBand from "../components/UpdatesBand.astro";
import ProductImage from '../components/ProductImage.astro';
import ProductCard from '../components/ProductCard.astro';
import products from '../data/products.json';
const insomniac = products.filter((product) => product.collection === 'Insomniac');
const yikes = products.filter((product) => product.collection === 'Yikes!');
const uniqueStyles = (pieces: typeof products, count: number) => {
  const seen = new Set<string>();
  return pieces.filter((product) => !seen.has(product.typeLabel) && Boolean(seen.add(product.typeLabel))).slice(0, count);
};
const featuredProducts = [...uniqueStyles(insomniac, 3), ...yikes.slice(0, 1)];
const heroProduct = featuredProducts[0] ?? products[0]!;
---

<Site
  title="Fall / Winter 2026 collection"
  description="Shop the Fall / Winter 2026 After Hours Agenda collection: hoodies, crewnecks and long sleeves. Free domestic shipping."
  preloadImage={{src:heroProduct.campaign[0]!.src,srcset:heroProduct.campaign[0]!.srcset,sizes:'(max-width: 760px) calc(100vw - 40px), 50vw'}}
>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="label">Independent clothing · Est. 2011</p>
      <h1>
        FOR THE
        <br />
        DREAMERS
        <br />
        <span>
          AND THE
          <br />
          DOERS.
        </span>
      </h1>
      <p class="lede">
        For good people who work hard, love hard, and celebrate the life they’re
        building.
      </p>
      <div class="actions">
        <a class="button" href="/shop/">
          Shop the collection <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="/about/">
          Our story →
        </a>
      </div>
      <p class="status-copy">
        Fall / Winter 2026. Made-to-order pieces with free domestic shipping.
      </p>
    </div>
    <figure class="hero-image">
      <span class="image-number" aria-hidden="true">
        {heroProduct.collection.toUpperCase()} / FALL–WINTER 2026
      </span>
      <ProductImage image={heroProduct!.campaign[0]!} priority sizes="(max-width: 760px) calc(100vw - 40px), 50vw" />
      <figcaption>
        {heroProduct!.title} · Campaign mockup · AI-generated
      </figcaption>
    </figure>
  </section>
  <div class="shell">
    <div class="chapter-strip">
      <span>Kindness. Community. A little individuality.</span>
      <span>For you and the people you love.</span>
    </div>
  </div>
  <section class="section shell" aria-labelledby="new-pieces"><div class="section-header"><div><p class="label">Fall / Winter 2026</p><h2 id="new-pieces">CURRENT PIECES.</h2></div><a class="text-link" href="/shop/">Shop all pieces →</a></div><div class="product-grid">{featuredProducts.map(product=><ProductCard product={product}/>)}</div></section>
  <section class="section shell story-grid" aria-labelledby="story-title">
    <figure class="archive-image">
      <Image
        name="2012-the-prologue"
        alt="The original After Hours Agenda Prologue, typed on paper in January 2012."
        sizes="(max-width: 760px) calc(100vw - 82px), 40vw"
      />
      <figcaption class="image-caption">
        The Prologue · Brand archive · January 2012
      </figcaption>
    </figure>
    <div>
      <p class="label">The first words still hold.</p>
      <h2 id="story-title">
        WE CREATE.
        <br />
        WE <span class="accent">BUILD.</span>
      </h2>
      <p>
        After hours is the part of the day that’s yours. The time you give to
        the people and the ideas you love, after the work is done.
      </p>
      <p>
        We wrote about dreamers, community and celebrating life in 2012. That is
        still who this is for.
      </p>
      <div class="actions">
        <a class="text-link" href="/about/">
          Read the story →
        </a>
        <a class="text-link" href="/manifesto/">
          The manifesto →
        </a>
      </div>
    </div>
  </section>
  <section class="section shell" aria-labelledby="lookbook-title">
    <div class="section-header">
      <div>
        <p class="label">From the collection</p>
        <h2 id="lookbook-title">
          OUR OWN
          <br />
          <span class="accent">KIND OF GOOD.</span>
        </h2>
      </div>
      <a class="text-link" href="/lookbook/">
        See the lookbook →
      </a>
    </div>
    <div class="teaser-grid">
      <figure>
        <ProductImage image={featuredProducts[0]!.campaign[0]!} sizes="(max-width: 760px) calc((100vw - 60px) * 0.579), 50vw" />
        <figcaption>
          <h3>{featuredProducts[0]!.title}.</h3>
          <p>{featuredProducts[0]!.campaignSetting} · Campaign mockup · AI-generated</p>
        </figcaption>
      </figure>
      <figure>
        <ProductImage image={featuredProducts.at(-1)!.campaign[2]!} sizes="(max-width: 760px) calc((100vw - 60px) * 0.421), 36vw" />
        <figcaption>
          <h3>{featuredProducts.at(-1)!.title}.</h3>
          <p>{featuredProducts.at(-1)!.campaignSetting} · Campaign mockup · AI-generated</p>
        </figcaption>
      </figure>
    </div>
  </section>
  <section class="shell section">
    <div class="statement">
      <img
        src="/brand/sheep.svg"
        width="260"
        height="204"
        alt="The After Hours Agenda black-sheep mark"
        loading="lazy"
      />
      <div>
        <p class="label">The Black Sheep</p>
        <h2>
          YOUR OWN WAY.
          <br />
          <span class="accent">GOOD COMPANY.</span>
        </h2>
        <p>
          The black sheep does things its own way and brings everyone along. For
          the people who make something of their time, and make room for one
          another.
        </p>
      </div>
    </div>
  </section>
  <UpdatesBand />
</Site>
