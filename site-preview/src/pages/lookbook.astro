---
import Site from "../layouts/Site.astro";
import Image from "../components/EditorialImage.astro";
import UpdatesBand from "../components/UpdatesBand.astro";
import { gallery } from "../data/site";
import manifest from "../data/images.json";
---

<Site
  title="Lookbook and archive"
  description="See the 2012 wordmark tee, 2013 Love / Vanity design and past Black Sheep pieces in the After Hours Agenda lookbook. New orders are paused."
>
  <header class="page-head shell">
    <p class="label">Concepts. Past pieces. Our story.</p>
    <h1>
      FOR YOU.
      <br />
      <span class="accent">AND YOUR PEOPLE.</span>
    </h1>
    <p class="lede">
      The 2012 wordmark tee sits beside Love / Vanity from 2013 and a later
      Black Sheep design. Browse past pieces and campaign ideas from the brand.
    </p>
    <p class="status-copy">
      Each caption tells you what you’re seeing: an archive piece, a previous-run
      render or an AI campaign concept. These pieces are not currently for sale.
    </p>
  </header>
  <div class="gallery shell">
    {gallery.map((shot, i) => (
      <figure>
        <Image
          name={shot.image as keyof typeof manifest}
          alt={shot.alt}
          priority={i === 0}
          sizes="(max-width: 360px) 100vw, 50vw"
        />
        <figcaption>
          <h2>{shot.caption}</h2>
          <p>{shot.note}</p>
        </figcaption>
      </figure>
    ))}
  </div>
  <UpdatesBand />
</Site>
