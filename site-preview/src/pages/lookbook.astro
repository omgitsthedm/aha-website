---
import Site from "../layouts/Site.astro";
import Image from "../components/EditorialImage.astro";
import { gallery } from "../data/site";
import manifest from "../data/images.json";
import MotionImage from '../components/MotionImage.astro';
import { photographedProduct } from '../data/photography';
import { motionFor } from '../data/motion';
import { campaignProducts, collectionSlug, collectionsInOrder, type Product } from '../data/collections';
import { allOffSale, isOffSale } from '../../server/catalog/off-sale.mjs';
// Apparel shoots only: knitwear remains available in the shop.
// Three looks: the lead piece's first photo, which carries the collection film, then the
// pieces that add a new setting or garment, each at the next photo so poses don't repeat.
function looksFor(pieces: readonly Product[]) {
  const chosen = [pieces[0]!];
  const score = (product: Product) =>
    (chosen.some((pick) => pick.campaignSetting === product.campaignSetting) ? 0 : 2) +
    (chosen.some((pick) => pick.typeLabel === product.typeLabel) ? 0 : 1);
  while (chosen.length < Math.min(3, pieces.length))
    chosen.push(pieces.filter((product) => !chosen.includes(product)).reduce((best, product) => (score(product) > score(best) ? product : best)));
  return [0, 1, 2].map((index) => {
    const product = chosen[index % chosen.length]!;
    return { product, shot: product.campaign[index % product.campaign.length]! };
  });
}
const sets = collectionsInOrder().filter(([, pieces]) => pieces.some(product => product.typeLabel !== 'Beanie')).map(([name, pieces]) => {
  const looks = looksFor(campaignProducts(pieces.map(photographedProduct)));
  return { name, slug: collectionSlug(name), looks };
});
const leadCampaignImage = sets[0]?.looks[0]?.shot;
---

<Site
  title="Out & About It."
  description="Explore the Fall / Winter 2026 campaign, styling ideas for graphic tees and fleece, and the original After Hours Agenda brand archive."
  preloadImage={leadCampaignImage ? { src: leadCampaignImage.src, srcset: leadCampaignImage.srcset, sizes: "(max-width: 760px) calc(100vw - 40px), 30vw" } : undefined}
>
  <header class="page-head shell editorial-head"><div><p class="label">The lookbook · Fall / Winter 2026</p><h1>OUT <span class="accent">&amp; ABOUT IT.</span></h1><p class="lede">Everyday plans. A little dressing up. Tap a photograph to find the piece.</p></div><p class="status-copy">Campaign imagery is AI-generated. Films pair licensed city footage with AI-generated garment shots. Product pages show garment views and measurements.</p></header>
  {sets.map((set, setIndex) => (
    <section class="shell campaign-set lookbook-set" data-look-set aria-labelledby={`look-${set.slug}`} hidden={allOffSale(set.looks.map(({ product }) => product))}>
      <div class="section-header">
        <div>
          <h2 id={`look-${set.slug}`}>{set.name}</h2>
        </div>
        <a class="text-link" href={`/shop/${set.slug}/`}>Shop the pieces</a>
      </div>
      <div class="campaign-grid">
        {set.looks.map(({ product, shot }, index) => (
          <figure data-product-set={product.slug} data-off-sale={isOffSale(product.slug) ? product.slug : undefined} hidden={isOffSale(product.slug)}>
            <MotionImage image={shot} priority={setIndex === 0 && index === 0} sizes={index === 0 ? "(max-width:760px) calc(100vw - 40px), 30vw" : "(max-width:760px) calc((100vw - 52px) / 2), 30vw"} tall />
            <a class="look-chip" href={`/shop/${product.slug}/`} aria-label={`Shop ${product.title} — ${product.color}`}>Shop </a>
            <figcaption><span class="still-note">0{index + 1} / {product.color} {product.typeLabel.toLowerCase()}</span>{motionFor(shot.src) && <span class="motion-note">{motionFor(shot.src)!.label}</span>}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  ))}
  <header class="shell section-header"><div><p class="label">Brand archive</p><h2>From the beginning.</h2><p>Original pieces from 2012 and 2013. Not currently for sale.</p></div></header>
  <div class="gallery shell">
    {gallery.filter(shot=>shot.note.startsWith('Brand archive')).map((shot) => (
      <figure>
        <Image
          name={shot.image as keyof typeof manifest}
          alt={shot.alt}
          sizes="(max-width: 360px) 100vw, 50vw"
        />
        <figcaption>
          <h2>{shot.caption}</h2>
          <p>{shot.note}</p>
        </figcaption>
      </figure>
    ))}
  </div>
</Site>
<script src="../scripts/retired-cards.ts"></script>
